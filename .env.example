# Copy to .env. Every value has a working default; set only what differs.

# Where libnvidia-ml.so lives.
#   Arch:          /usr/lib   (default)
#   Debian/Ubuntu: /usr/lib/x86_64-linux-gnu
#NVIDIA_LIB_DIR=/usr/lib

# Prometheus retention. Both apply; whichever is reached first wins.
#RETENTION_TIME=2y
#RETENTION_SIZE=30GB

# Grafana credentials. Anonymous read-only viewing is on regardless, so these
# only gate editing.
#GF_ADMIN_USER=admin
#GF_ADMIN_PASSWORD=change-me

# The harness exporter reads AI coding session files from your home directory
# and shares its ledger with `rig ai` on the host, so it runs as you. Change
# these if your account is not the usual first one. `id -u` / `id -g`.
#RIG_UID=1000
#RIG_GID=1000

# Whose harnesses to read, and where the ledger and price cache live.
#RIG_AI_HOME=/home/you
#RIG_AI_CACHE=/home/you/.cache/rig-telemetry

# Seconds between passes over the session files, and how many projects keep
# their own series before the rest fold into `other`.
#RIG_AI_INTERVAL=60
#RIG_AI_TOP_PROJECTS=80
