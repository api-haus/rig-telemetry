def main() -> int:
    # Carried by the top-level parser and by every subparser, so both
    # `rig --json why` and `rig why --json` work. Only one position working is
    # a trap for anything driving this from a script.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--at", metavar="RFC3339", help="evaluate at a past instant, e.g. 2026-08-14T03:00:00Z")

    p = argparse.ArgumentParser(prog="rig", description=__doc__, parents=[common],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    s = sub.add_parser("why", help="one-shot verdict: what is wrong right now")
    s.set_defaults(fn=cmd_why)

    s = sub.add_parser("who", help="rank process groups by resource use")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--top", type=int, default=12)
    s.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now, e.g. 24h")
    s.add_argument("--agg", choices=["avg", "max", "min"], default="max")
    s.set_defaults(fn=cmd_who)

    s = sub.add_parser("timeline", help="load over time with the group that owned it")
    s.add_argument("--since", metavar="DUR", default="6h")
    s.add_argument("--step", metavar="DUR")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--agg", choices=["avg", "max"], default="max")
    s.add_argument("--top", type=int, default=3, help="groups to rank per bucket")
    s.add_argument("--show", type=int, default=3, help="groups to print per bucket")
    s.add_argument("--min-load", type=float, default=0.0, help="hide quiet buckets below this load-per-core")
    s.set_defaults(fn=cmd_timeline)

    s = sub.add_parser("where", help="where the stack is installed on this machine")
    s.add_argument("--quiet", "-q", action="store_true", help="print the path alone")
    s.set_defaults(fn=cmd_where)

    s = sub.add_parser("containers", help="docker resource use, per compose stack")
    s.add_argument("--each", action="store_true", help="one row per container instead of per stack")
    s.add_argument("--sort", choices=sorted(STACK_BY), default="mem")
    s.add_argument("--top", type=int, default=15)
    s.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now")
    s.add_argument("--agg", choices=["avg", "max"], default="max")
    s.set_defaults(fn=cmd_containers)

    s = sub.add_parser("net", help="who is using the link, and why it feels slow")
    s.add_argument("--top", type=int, default=10)
    s.set_defaults(fn=cmd_net)
    net = s.add_subparsers(dest="netcmd",
                           parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    n = net.add_parser("who", help="process groups ranked by internet traffic")
    n.add_argument("--top", type=int, default=15)
    n.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now")
    n.add_argument("--agg", choices=["avg", "max"], default="max")
    n.set_defaults(fn=cmd_net_who)

    n = net.add_parser("peers", help="the addresses the traffic goes to")
    n.add_argument("--top", type=int, default=15)
    n.add_argument("--no-resolve", action="store_true", help="skip reverse DNS")
    n.set_defaults(fn=cmd_net_peers)

    n = net.add_parser("conns", help="every live connection, with its round trip time")
    n.add_argument("--top", type=int, default=25)
    n.add_argument("--sort", choices=["bytes", "rtt", "retrans"], default="bytes")
    n.add_argument("--group", help="only this process group")
    n.add_argument("--no-resolve", action="store_true", help="skip reverse DNS")
    n.set_defaults(fn=cmd_net_conns)

    n = net.add_parser("speedtest", help="fill the line, and measure the queue that makes")
    n.add_argument("--seconds", type=float, default=10, help="how long to hold each direction")
    n.add_argument("--down-only", action="store_true", help="skip the upload half")
    n.set_defaults(fn=cmd_net_speedtest)

    n = net.add_parser("doctor", help="what is measured, what is missing, and how to fix it")
    n.set_defaults(fn=cmd_net_doctor)

    s = sub.add_parser("thermals", help="temperatures and cooling degradation vs baseline")
    s.set_defaults(fn=cmd_thermals)

    s = sub.add_parser("disk", help="io, filesystems and SMART wear")
    s.set_defaults(fn=cmd_disk)

    s = sub.add_parser("alerts", help="what is firing")
    s.set_defaults(fn=cmd_alerts)

    s = sub.add_parser("health", help="is this stack itself working")
    s.set_defaults(fn=cmd_health)

    s = sub.add_parser("ai", help="what the AI coding harnesses spent, at API list prices")
    s.add_argument("--since", metavar="DUR", help="limit to a window, e.g. 30d")
    s.add_argument("--top", type=int, default=12)
    s.set_defaults(fn=cmd_ai)
    ai = s.add_subparsers(dest="aicmd",
                          parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    a = ai.add_parser("daily", help="spend per day")
    a.add_argument("--since", metavar="DUR", default="30d")
    a.add_argument("--by-harness", action="store_true", help="one column per harness")
    a.set_defaults(fn=cmd_ai_daily)

    a = ai.add_parser("projects", help="spend per project")
    a.add_argument("--since", metavar="DUR")
    a.add_argument("--top", type=int, default=25)
    a.set_defaults(fn=cmd_ai_projects)

    a = ai.add_parser("models", help="spend per model, with the rates used")
    a.add_argument("--since", metavar="DUR")
    a.set_defaults(fn=cmd_ai_models)

    a = ai.add_parser("clock", help="what a seller's peak window costs at your hours")
    a.add_argument("--hours", type=float, default=8, help="session hours in a day")
