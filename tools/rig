#!/usr/bin/env python3
"""rig — read the telemetry stack from a terminal or an agent.

Every subcommand takes --json for machine consumption and --at/--since to ask
about the past instead of now. Python standard library only, on purpose: this
has to keep working when the thing it is diagnosing is broken.

See AGENTS.md for the query vocabulary.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

PROM = os.environ.get("RIG_PROMETHEUS", "http://127.0.0.1:13390")
TIMEOUT = float(os.environ.get("RIG_TIMEOUT", "30"))

UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800, "y": 31536000}


# --------------------------------------------------------------------------
# prometheus access
# --------------------------------------------------------------------------

class PromError(RuntimeError):
    pass


def _call(path: str, params: dict, method: str = "POST") -> dict:
    url = f"{PROM}/api/v1/{path}"
    if method == "GET":
        req = urllib.request.Request(f"{url}?{urllib.parse.urlencode(params)}")
    else:
        req = urllib.request.Request(url, data=urllib.parse.urlencode(params).encode(), method="POST")
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        raise PromError(f"{e.code} from {url}: {e.read()[:400].decode(errors='replace')}") from e
    except urllib.error.URLError as e:
        raise PromError(f"cannot reach Prometheus at {PROM}: {e.reason}. Is the stack up? `docker compose ps`") from e
    if body.get("status") != "success":
        raise PromError(f"{body.get('errorType')}: {body.get('error')}")
    return body["data"]


def query(expr: str, at: str | None = None) -> list[dict]:
    params = {"query": expr}
    if at:
        params["time"] = at
    return _call("query", params)["result"]


def query_range(expr: str, start: str, end: str, step: str) -> list[dict]:
    return _call("query_range", {"query": expr, "start": start, "end": end, "step": step})["result"]


def scalar(expr: str, at: str | None = None, default=None):
    """First sample of an instant query, as a float."""
    res = query(expr, at)
    if not res:
        return default
    try:
        return float(res[0]["value"][1])
    except (KeyError, IndexError, ValueError):
        return default


def series(expr: str, label: str, at: str | None = None) -> list[tuple[str, float]]:
    """Instant query flattened to (label_value, value), largest first."""
    out = []
    for s in query(expr, at):
        name = s["metric"].get(label) or s["metric"].get("__name__") or "?"
        try:
            out.append((name, float(s["value"][1])))
        except (KeyError, IndexError, ValueError):
            continue
    return sorted(out, key=lambda kv: kv[1], reverse=True)


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------

def human_bytes(n: float | None) -> str:
    if n is None:
        return "n/a"
    for unit in ("B", "K", "M", "G", "T", "P"):
        if abs(n) < 1024:
            return f"{n:.1f}{unit}" if unit != "B" else f"{n:.0f}B"
        n /= 1024
    return f"{n:.1f}E"


def num(v, fmt="{:.2f}", dash="n/a") -> str:
    return dash if v is None else fmt.format(v)


def pct(v) -> str:
    return "n/a" if v is None else f"{v * 100:.1f}%"


def rule(title: str = "", width: int = 74) -> str:
    if not title:
        return "-" * width
    return f"-- {title} " + "-" * max(0, width - len(title) - 4)


def table(rows: list[tuple], headers: tuple, indent: str = "  ") -> str:
    if not rows:
        return indent + "(nothing)"
    cols = list(zip(*([headers] + [tuple(str(c) for c in r) for r in rows])))
    widths = [max(len(str(c)) for c in col) for col in cols]
    out = [indent + "  ".join(str(h).ljust(w) for h, w in zip(headers, widths)).rstrip()]
    out.append(indent + "  ".join("-" * w for w in widths))
    for r in rows:
        out.append(indent + "  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def parse_duration(text: str) -> timedelta:
    text = text.strip()
    if text and text[-1] in UNITS and text[:-1].replace(".", "", 1).isdigit():
        return timedelta(seconds=float(text[:-1]) * UNITS[text[-1]])
    raise SystemExit(f"rig: bad duration {text!r}; use 30m, 6h, 7d, 2w")


def window(args) -> tuple[str, str, str]:
    """(start, end, step) as RFC3339 strings for the range API."""
    end = datetime.fromisoformat(args.at.replace("Z", "+00:00")) if getattr(args, "at", None) \
        else datetime.now(timezone.utc)
    span = parse_duration(args.since)
    start = end - span
    step = getattr(args, "step", None) or f"{max(15, int(span.total_seconds() // 400))}s"
    return start.isoformat(), end.isoformat(), step


# --------------------------------------------------------------------------
# rig why — the one-shot verdict
# --------------------------------------------------------------------------

def cmd_why(args) -> int:
    at = args.at
    f = {
        "load1": scalar("max(node_load1)", at),
        "load_per_cpu": scalar("rig:load:per_cpu", at),
        "runnable": scalar("rig:load:runnable", at),
        "blocked": scalar("rig:load:blocked", at),
        "io_bound": scalar("rig:load:io_bound_ratio", at),
        "cpu_busy": scalar("rig:cpu:busy_ratio", at),
        "cpu_iowait": scalar("rig:cpu:iowait_ratio", at),
        "psi_cpu": scalar("rig:psi:cpu_some", at),
        "psi_io_some": scalar("rig:psi:io_some", at),
        "psi_io_full": scalar("rig:psi:io_full", at),
        "psi_mem_full": scalar("rig:psi:memory_full", at),
        "mem_used": scalar("rig:mem:used_ratio", at),
        "swap_used": scalar("rig:mem:swap_used_bytes", at),
        "swap_rate": scalar("rig:mem:swap_pages_per_sec", at),
        "cpu_c": scalar("rig:cpu_celsius", at),
        "gpu_c": scalar("rig:gpu_celsius", at),
        "gpu_headroom": scalar("rig:thermal:gpu_headroom_c", at),
    }

    verdict, because = classify(f)

    tops = {
        "blocked": series("topk(5, rig:proc:blocked > 0)", "groupname", at),
        "cpu": series("topk(5, rig:proc:cpu_cores > 0.05)", "groupname", at),
        "faults": series("topk(5, rig:proc:major_faults_per_sec > 1)", "groupname", at),
        "io": series("topk(5, rig:proc:io_bytes_per_sec > 0)", "groupname", at),
        "rss": series("topk(5, rig:proc:rss_proportional_bytes)", "groupname", at),
        "swap": series("topk(5, rig:proc:swap_bytes > 0)", "groupname", at),
    }
    disk = series("topk(4, rig:disk:util_ratio > 0.01)", "device", at)
    firing = series('ALERTS{alertstate="firing"}', "alertname", at)

    if args.json:
        print(json.dumps({"verdict": verdict, "because": because, "facts": f,
                          "top": tops, "disk_util": disk,
                          "firing": [a for a, _ in firing]}, indent=2))
        return 0

    print(f"VERDICT: {verdict}")
    for line in because:
        print(f"         {line}")
    print()
    print(rule("load"))
    print(f"  load1 {num(f['load1'], '{:.0f}')} ({num(f['load_per_cpu'], '{:.1f}')}x cores)"
          f"   runnable {num(f['runnable'], '{:.0f}')}   blocked-on-io {num(f['blocked'], '{:.0f}')}")
    print(f"  cpu busy {pct(f['cpu_busy'])}   iowait {pct(f['cpu_iowait'])}")
    print(f"  stalled: cpu {pct(f['psi_cpu'])}   io-some {pct(f['psi_io_some'])}   "
          f"io-ALL {pct(f['psi_io_full'])}   mem-ALL {pct(f['psi_mem_full'])}")
    print(f"  memory {pct(f['mem_used'])} used, swap {human_bytes(f['swap_used'])}, "
          f"{num(f['swap_rate'], '{:.0f}')} pages/s through swap")
    print()
    for key, title, fmt in (
        ("blocked", "who is blocked on io (procs)", "{:.0f}"),
        ("cpu", "who is using cpu (cores)", "{:.2f}"),
        ("faults", "who is paging from disk (faults/s)", "{:.0f}"),
        ("io", "who is doing io (bytes/s)", None),
        ("rss", "who holds memory (proportional)", None),
        ("swap", "who is swapped out", None),
    ):
        rows = [(n, human_bytes(v) if fmt is None else fmt.format(v)) for n, v in tops[key]]
        print(rule(title))
        print(table(rows, ("group", "value")))
        print()
    print(rule("disk"))
    print(table([(d, pct(v)) for d, v in disk], ("device", "busy")))
    print()
    print(rule("thermal"))
    print(f"  cpu {num(f['cpu_c'], '{:.0f}')}C   gpu {num(f['gpu_c'], '{:.0f}')}C"
          f"   gpu headroom to throttle {num(f['gpu_headroom'], '{:.0f}')}C")
    print()
    print(rule("firing alerts"))
    print(table([(a,) for a, _ in firing] or [], ("alert",)))
    return 0


def classify(f: dict) -> tuple[str, list[str]]:
    """Name the bottleneck. Order matters: memory thrash masquerades as IO."""
    io_full = f["psi_io_full"] or 0
    mem_full = f["psi_mem_full"] or 0
    swap_rate = f["swap_rate"] or 0
    cpu_busy = f["cpu_busy"] or 0
    psi_cpu = f["psi_cpu"] or 0
    load_pc = f["load_per_cpu"] or 0
    io_bound = f["io_bound"] or 0

    if io_full > 0.3 and swap_rate > 2000:
        return "MEMORY THRASH — swap is eating the disk", [
            f"the whole machine is stalled on io {io_full * 100:.0f}% of the time,",
            f"and {swap_rate:.0f} pages/s are moving through swap.",
            "the disk is busy serving memory, not work. cpu is a red herring.",
            "-> topk(5, rig:proc:major_faults_per_sec) names the process paying for it.",
        ]
    if io_full > 0.3:
        return "IO STALL — everything is queued behind a disk", [
            f"the whole machine is stalled on io {io_full * 100:.0f}% of the time.",
            f"load is {load_pc:.1f}x cores and {io_bound * 100:.0f}% of it is blocked, not running.",
            "-> topk(5, rig:proc:blocked) names who is in the queue.",
        ]
    if mem_full > 0.2:
        return "MEMORY PRESSURE — reclaim is stalling work", [
            f"tasks stalled on memory reclaim {mem_full * 100:.0f}% of the time.",
            "-> topk(5, rig:proc:rss_proportional_bytes)",
        ]
    if cpu_busy > 0.9 and psi_cpu > 0.4:
        return "CPU SATURATED — more runnable work than cores", [
            f"cpu is {cpu_busy * 100:.0f}% busy and tasks queue for it {psi_cpu * 100:.0f}% of the time.",
            "-> topk(5, rig:proc:cpu_cores)",
        ]
    if load_pc > 2 and io_bound > 0.7:
        return "IO BOUND — load is high but the cpu is idle", [
            f"load {load_pc:.1f}x cores, {io_bound * 100:.0f}% of it blocked on io.",
            "this load average is not a cpu problem.",
        ]
    if cpu_busy > 0.8:
        return "BUSY — cpu working, nothing queueing badly", [
            f"cpu {cpu_busy * 100:.0f}% busy, no significant stall.",
        ]
    return "HEALTHY — nothing is saturated", [
        f"load {load_pc:.1f}x cores, cpu {cpu_busy * 100:.0f}% busy, io stall {io_full * 100:.0f}%.",
    ]


# --------------------------------------------------------------------------
# rig who — attribution
# --------------------------------------------------------------------------

BY = {
    "cpu": ("rig:proc:cpu_cores", "cores", "{:.2f}"),
    "blocked": ("rig:proc:blocked", "procs blocked on io", "{:.0f}"),
    "running": ("rig:proc:running", "procs running", "{:.0f}"),
    "mem": ("rig:proc:rss_proportional_bytes", "resident (proportional)", None),
    "rss": ("rig:proc:rss_bytes", "resident (counts shared twice)", None),
    "swap": ("rig:proc:swap_bytes", "swapped out", None),
    "io": ("rig:proc:io_bytes_per_sec", "bytes/s read+written", None),
    "read": ("rig:proc:read_bytes_per_sec", "bytes/s read", None),
    "write": ("rig:proc:write_bytes_per_sec", "bytes/s written", None),
    "faults": ("rig:proc:major_faults_per_sec", "major faults/s (paging from disk)", "{:.1f}"),
    "procs": ("rig:proc:count", "process count", "{:.0f}"),
    "threads": ("rig:proc:threads", "thread count", "{:.0f}"),
    "fds": ("rig:proc:open_fds", "open file descriptors", "{:.0f}"),
    "switches": ("rig:proc:context_switches_per_sec", "context switches/s", "{:.0f}"),
}


def cmd_who(args) -> int:
    metric, unit, fmt = BY[args.by]
    if args.since:
        span = args.since
        expr = f"topk({args.top}, {args.agg}_over_time({metric}[{span}]))"
        header = f"top {args.top} by {args.by} — {args.agg} over the last {span}"
    else:
        expr = f"topk({args.top}, {metric})"
        header = f"top {args.top} by {args.by} — now"
    rows = series(expr, "groupname", args.at)

    if args.json:
        print(json.dumps({"metric": metric, "unit": unit, "expr": expr,
                          "rows": [{"group": g, "value": v} for g, v in rows]}, indent=2))
        return 0

    print(header)
    print(f"  ({metric}, {unit})\n")
    print(table([(g, human_bytes(v) if fmt is None else fmt.format(v)) for g, v in rows],
                ("group", "value")))
    return 0


# --------------------------------------------------------------------------
# rig timeline — when did it go wrong, and who owned it
# --------------------------------------------------------------------------

def cmd_timeline(args) -> int:
    start, end, step = window(args)
    metric, _, fmt = BY[args.by]
    load = query_range("rig:load:per_cpu", start, end, step)
    stall = query_range("rig:psi:io_full", start, end, step)
    top = query_range(f"topk({args.top}, {args.agg}_over_time({metric}[{step}]))", start, end, step)

    load_pts = {int(float(t)): v for t, v in (load[0]["values"] if load else [])}
    stall_pts = {int(float(t)): v for t, v in (stall[0]["values"] if stall else [])}
    owners: dict[int, list[tuple[str, float]]] = {}
    for s in top:
        g = s["metric"].get("groupname", "?")
        for t, v in s["values"]:
            owners.setdefault(int(float(t)), []).append((g, float(v)))

    rows = []
    for t in sorted(load_pts):
        lv = float(load_pts[t])
        if args.min_load and lv < args.min_load:
            continue
        who = sorted(owners.get(t, []), key=lambda kv: kv[1], reverse=True)[:args.show]
        rows.append((
            datetime.fromtimestamp(t, timezone.utc).astimezone().strftime("%m-%d %H:%M"),
            f"{lv:.1f}x",
            f"{float(stall_pts.get(t, 0)) * 100:.0f}%",
            ", ".join(f"{g} {human_bytes(v) if fmt is None else fmt.format(v)}" for g, v in who) or "-",
        ))

    if args.json:
        print(json.dumps([dict(zip(("time", "load_per_cpu", "io_stall", "top"), r)) for r in rows], indent=2))
        return 0

    print(f"load and its owners, {args.since} back, {step} buckets, ranked by {args.by}")
    if args.min_load:
        print(f"(only buckets where load >= {args.min_load}x cores)")
    print()
    print(table(rows, ("time", "load", "io-stall", f"top {args.show} by {args.by}")))
    return 0


