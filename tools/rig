NET_EXPORTER = os.environ.get("RIG_NET_EXPORTER", "http://127.0.0.1:13370")


def _live_flows() -> dict:
    """The connection table, read from the exporter rather than Prometheus.

    Per-connection detail is deliberately never a metric — one series per
    socket would cost more than every other reading on this machine.
    """
    try:
        with urllib.request.urlopen(f"{NET_EXPORTER}/flows", timeout=TIMEOUT) as r:
            return json.load(r)
    except (urllib.error.URLError, OSError) as e:
        root, _ = stack_root()
        raise SystemExit(
            f"rig: no net exporter at {NET_EXPORTER}: {e}\n"
            f"  start it with:\n"
            f"    cd {root} && docker compose up -d net-exporter\n"
            f"  point elsewhere with RIG_NET_EXPORTER=http://host:port")


def _net_facts(at) -> dict:
    by_target = lambda expr: dict(series(expr, "target", at))
    kinds = {s["metric"].get("target", "?"): s["metric"].get("kind", "?")
             for s in query("rig:net:rtt_seconds", at)}
    return {
        "kinds": kinds,
        "down_bits": scalar("rig:net:link:rx_bits_per_sec", at),
        "up_bits": scalar("rig:net:link:tx_bits_per_sec", at),
        "capacity_down": scalar("rig:net:link:capacity_rx_bits_per_sec", at),
        "capacity_up": scalar("rig:net:link:capacity_tx_bits_per_sec", at),
        "peak_down": scalar("rig:net:link:peak_rx_bits_per_sec", at),
        "peak_up": scalar("rig:net:link:peak_tx_bits_per_sec", at),
        "saturation": scalar("rig:net:link:rx_saturation", at),
        "share_of_peak": scalar("rig:net:link:rx_share_of_peak", at),
        "rtt": by_target("rig:net:rtt_seconds"),
        "floor": by_target("rig:net:rtt_floor_seconds"),
        "worst": by_target("rignet_probe_rtt_worst_seconds"),
        "bloat": by_target("rig:net:bufferbloat_ratio"),
        "loss": by_target("rig:net:loss_ratio"),
        "retransmit_ratio": scalar("rig:net:retransmit_ratio", at),
        "resolver": scalar("rig:net:resolver_seconds", at),
        "established": scalar("rig:net:tcp_established", at),
        "wifi_signal": dict(series("rig:net:wifi_signal_dbm", "device", at)),
        "wifi_retries": dict(series("rig:net:wifi_retries_per_sec", "device", at)),
        "attributed": scalar("rig:net:attributed_ratio", at),
        "unattributed_bytes": scalar("rig:net:unattributed_bytes_per_sec", at),
        "conntrack": scalar("rig:net:conntrack_available", at),
        "age": scalar("rig:net:scrape_age_seconds", at),
        "device": (series("rignet_default_route", "device", at) or [("?", 0)])[0][0],
    }


def classify_net(f: dict) -> tuple[str, list[str]]:
    """Name what is wrong with the link. Throughput alone never answers it."""
    if f["age"] is None:
        return "NO DATA — the net exporter is not being scraped", [
            "docker compose up -d net-exporter, then rig health.",
        ]
    if f["age"] > 120:
        return "STALE — the net exporter stopped reporting", [
            f"its last pass was {f['age'] / 60:.0f} minutes ago.",
            "docker compose logs net-exporter",
        ]
    bloat = max(f["bloat"].values() or [0])
    rtt = max(f["rtt"].values() or [0])
    loss = max(f["loss"].values() or [0])
    signal = min(f["wifi_signal"].values() or [0])
    saturation = f["saturation"] or 0
    share = f["share_of_peak"] or 0

    # Judged per target: a gateway that answers in 1ms is 3x queued the moment
    # it answers in 3ms, and that is noise, not a queue.
    queued = {t: r for t, r in f["bloat"].items() if r > 4 and (f["rtt"].get(t) or 0) > 0.1}
    if queued:
        worst = max(queued, key=queued.get)
        bloat = queued[worst]
        return "QUEUED — the line is full and everything waits behind it", [
            f"round trip to {worst} is {f['rtt'][worst] * 1000:.0f}ms against "
            f"{f['floor'][worst] * 1000:.0f}ms idle — {bloat:.1f}x.",
            "this is a queue, not a shortage of bandwidth. Capping a download's rate",
            "only helps if the cap is below what the line carries; the queue is the lag.",
        ]
    if saturation > 0.85:
        return "FULL — the line is carrying everything it is sold to carry", [
            f"downlink {saturation * 100:.0f}% of {human_bits(f['capacity_down'])}.",
        ]
    if not f["capacity_down"] and share > 0.9 and (f["down_bits"] or 0) > 1e6:
        return "AT ITS OWN CEILING — as fast as this line has ever gone", [
            f"{human_bits(f['down_bits'])} down, against a 7-day best of "
            f"{human_bits(f['peak_down'])}.",
            "set RIG_NET_DOWN_MBIT in .env to compare against what you pay for.",
        ]
    if loss > 0.03:
        gateway = [t for t in f["loss"] if f["loss"][t] > 0.03]
        return "LOSSY — packets are not coming back", [
            f"{loss * 100:.0f}% loss to {', '.join(gateway)}.",
            "loss to the gateway is the radio or the cable; loss only past it is the ISP.",
        ]
    if -100 < signal < -72:
        return "WEAK RADIO — the wifi link is slow before anything else is", [
            f"{signal:.0f} dBm. The radio drops to low rates and spends its airtime retrying.",
        ]
    if (f["resolver"] or 0) > 1:
        return "RESOLVER SLOW — names take longer than pages", [
            f"{f['resolver'] * 1000:.0f}ms to turn a name into an address.",
        ]
    if (f["down_bits"] or 0) < 1e5 and (f["up_bits"] or 0) < 1e5:
        return "IDLE — nothing is using the link", [
            f"{human_bits(f['down_bits'])} down, {human_bits(f['up_bits'])} up.",
        ]
    return "HEALTHY — the link is busy and nothing is queueing", [
        f"{human_bits(f['down_bits'])} down, {human_bits(f['up_bits'])} up, "
        f"round trip {rtt * 1000:.0f}ms at {bloat:.1f}x idle.",
    ]


def _net_groups(at, since: str = "", agg: str = "max", top: int = 10) -> list[tuple]:
    """Process groups ranked by what they pull off the uplink."""
    wrap = (lambda m: f"{agg}_over_time({m}[{since}])") if since else (lambda m: m)
    down = dict(series(f"topk({top}, {wrap('rig:net:proc:uplink_rx_bytes_per_sec')})", "groupname", at))
    up = dict(series(wrap("rig:net:proc:uplink_tx_bytes_per_sec"), "groupname", at))
    conns = dict(series(wrap("rig:net:proc:connections"), "groupname", at))
    rtt = dict(series(wrap("rig:net:proc:rtt_seconds"), "groupname", at))
    retrans = dict(series(wrap("rig:net:proc:retransmit_bytes_per_sec"), "groupname", at))
    rows = []
    for g in sorted(down, key=lambda k: -(down[k] + up.get(k, 0))):
        rows.append((g, down[g], up.get(g, 0.0), conns.get(g, 0.0),
                     rtt.get(g), retrans.get(g, 0.0)))
    return rows


def _net_containers(at, since: str = "", agg: str = "max", top: int = 8) -> list[tuple]:
    """Containers keep their sockets in their own namespace; cAdvisor reads it."""
    wrap = (lambda m: f"{agg}_over_time({m}[{since}])") if since else (lambda m: m)
    down = dict(series(f"topk({top}, {wrap('rig:net:container:rx_bytes_per_sec')} > 128)",
                       "name", at))
    up = dict(series(wrap("rig:net:container:tx_bytes_per_sec"), "name", at))
    return [(n, v, up.get(n, 0.0)) for n, v in sorted(down.items(), key=lambda kv: -kv[1])]


