#
# These read the SQLite ledger rather than Prometheus. The ledger holds every
# session file still on disk, which reaches back further than the stack has
# been recording, and it answers when the stack is down.

def _ledger(args, write: bool = False):
    import harness_usage as hu
    try:
        return hu, hu.open_ledger(read_only=not write)
    except FileNotFoundError:
        raise SystemExit(
            f"rig: no usage ledger at {hu.ledger_path()}\n"
            "  the harness exporter has not run yet. start the stack:\n"
            f"    cd {stack_root()[0]} && docker compose up -d harness-exporter\n"
            "  or build it here and now:  rig ai scan")


def _since_day(args) -> str:
    """The ledger buckets by local day, so the cutoff is a local day too."""
    if not getattr(args, "since", None):
        return ""
    return (datetime.now() - parse_duration(args.since)).strftime("%Y-%m-%d")


def money(v) -> str:
    return "n/a" if v is None else f"${v:,.2f}"


def toks(v) -> str:
    if v is None:
        return "n/a"
    for unit, div in (("T", 1e12), ("B", 1e9), ("M", 1e6), ("k", 1e3)):
        if abs(v) >= div:
            return f"{v / div:.2f}{unit}"
    return f"{v:.0f}"


def cmd_ai(args) -> int:
    hu, db = _ledger(args)
    since = _since_day(args)
    prices = hu.Prices(hu.load_catalogue(refresh=False))
    span = f"since {since}" if since else "all recorded history"
    total = hu.totals(db, (), since=since, prices=prices)[0]
    if not total["requests"]:
        print(f"no harness usage recorded {span}.")
        return 0

    billed = sum(total[r] for r in hu.BILLED_ROLES)
    first, last = hu.day_bounds(db)
    by_harness = hu.totals(db, ("harness",), since=since, prices=prices)
    by_model = hu.totals(db, ("harness", "model"), since=since, prices=prices)
    by_project = hu.totals(db, ("harness", "project"), since=since, prices=prices)[:args.top]
    by_kind = hu.totals(db, ("kind",), since=since, prices=prices)
    roles = _role_costs(hu, db, since, prices)

    if args.json:
        print(json.dumps({"window": span, "recorded": [first, last], "total": total,
                          "by_harness": by_harness, "by_model": by_model,
                          "by_project": by_project, "by_kind": by_kind,
                          "by_role": roles}, indent=2))
        return 0

    print(f"API list value of everything the coding harnesses did, {span}")
    print(f"(session files on disk cover {first} to {last})\n")
    print(rule("total"))
    print(f"  {money(total['cost'])} across {total['requests']:,.0f} API responses "
          f"and {toks(billed)} billable tokens")
    reported = total["reported_cost"]
    if reported:
        print(f"  harnesses that report a cost themselves claim {money(reported)} of it")
    print(f"  {money(total['cost'] / max(billed, 1) * 1e6)} per million tokens, blended")
    print()

    print(rule("by harness"))
    print(table([(r["harness"], money(r["cost"]), toks(sum(r[k] for k in hu.BILLED_ROLES)),
                  f"{r['requests']:,.0f}") for r in by_harness],
                ("harness", "list value", "tokens", "responses")))
