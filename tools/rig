def _net_peers(at, top: int = 12) -> list[tuple]:
    down = dict(series(f'topk({top}, rig:net:peer:rx_bytes_per_sec{{scope="internet"}})',
                       "peer", at))
    up: dict[str, float] = {}
    service: dict[str, str] = {}
    for s in query('rig:net:peer:tx_bytes_per_sec{scope="internet"}', at):
        peer = s["metric"].get("peer", "?")
        up[peer] = up.get(peer, 0.0) + float(s["value"][1])
    for s in query('rig:net:peer:rx_bytes_per_sec{scope="internet"}', at):
        service[s["metric"].get("peer", "?")] = s["metric"].get("service", "?")
    return [(p, service.get(p, "?"), v, up.get(p, 0.0))
            for p, v in sorted(down.items(), key=lambda kv: -kv[1])]


def _hostnames(addresses: list[str]) -> dict[str, str]:
    """Reverse DNS for a handful of addresses, in parallel and never for long."""
    import concurrent.futures
    import socket as _socket

    def one(addr: str) -> str:
        try:
            return _socket.gethostbyaddr(addr)[0]
        except OSError:
            return ""

    _socket.setdefaulttimeout(1.0)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        return dict(zip(addresses, pool.map(one, addresses)))


