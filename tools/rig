BY = {
    "cpu": ("rig:proc:cpu_cores", "cores", "{:.2f}"),
    "blocked": ("rig:proc:blocked", "procs blocked on io", "{:.0f}"),
    "running": ("rig:proc:running", "procs running", "{:.0f}"),
    "mem": ("rig:proc:rss_proportional_bytes", "resident (proportional)", None),
    "rss": ("rig:proc:rss_bytes", "resident (counts shared twice)", None),
    "swap": ("rig:proc:swap_bytes", "swapped out", None),
    "io": ("rig:proc:io_bytes_per_sec", "bytes/s read+written", None),
    "read": ("rig:proc:read_bytes_per_sec", "bytes/s read", None),
    "write": ("rig:proc:write_bytes_per_sec", "bytes/s written", None),
    "faults": ("rig:proc:major_faults_per_sec", "major faults/s (paging from disk)", "{:.1f}"),
    "net": ("rig:net:proc:uplink_bytes_per_sec", "bytes/s to and from the internet", None),
    "down": ("rig:net:proc:uplink_rx_bytes_per_sec", "bytes/s pulled from the internet", None),
    "up": ("rig:net:proc:uplink_tx_bytes_per_sec", "bytes/s pushed to the internet", None),
    "conns": ("rig:net:proc:connections", "open connections", "{:.0f}"),
    "procs": ("rig:proc:count", "process count", "{:.0f}"),
    "threads": ("rig:proc:threads", "thread count", "{:.0f}"),
    "fds": ("rig:proc:open_fds", "open file descriptors", "{:.0f}"),
    "switches": ("rig:proc:context_switches_per_sec", "context switches/s", "{:.0f}"),
}


def cmd_who(args) -> int:
    metric, unit, fmt = BY[args.by]
    if args.since:
        span = args.since
        expr = f"topk({args.top}, {args.agg}_over_time({metric}[{span}]))"
        header = f"top {args.top} by {args.by} — {args.agg} over the last {span}"
    else:
        expr = f"topk({args.top}, {metric})"
        header = f"top {args.top} by {args.by} — now"
    rows = series(expr, "groupname", args.at)

    if args.json:
        print(json.dumps({"metric": metric, "unit": unit, "expr": expr,
                          "rows": [{"group": g, "value": v} for g, v in rows]}, indent=2))
        return 0

    print(header)
    print(f"  ({metric}, {unit})\n")
    print(table([(g, human_bytes(v) if fmt is None else fmt.format(v)) for g, v in rows],
                ("group", "value")))
    return 0


# --------------------------------------------------------------------------
# rig timeline — when did it go wrong, and who owned it
# --------------------------------------------------------------------------

def cmd_timeline(args) -> int:
    start, end, step = window(args)
    metric, _, fmt = BY[args.by]
    load = query_range("rig:load:per_cpu", start, end, step)
    stall = query_range("rig:psi:io_full", start, end, step)
    top = query_range(f"topk({args.top}, {args.agg}_over_time({metric}[{step}]))", start, end, step)

    load_pts = {int(float(t)): v for t, v in (load[0]["values"] if load else [])}
    stall_pts = {int(float(t)): v for t, v in (stall[0]["values"] if stall else [])}
    owners: dict[int, list[tuple[str, float]]] = {}
    for s in top:
        g = s["metric"].get("groupname", "?")
        for t, v in s["values"]:
            owners.setdefault(int(float(t)), []).append((g, float(v)))

    rows = []
    for t in sorted(load_pts):
        lv = float(load_pts[t])
        if args.min_load and lv < args.min_load:
            continue
        who = sorted(owners.get(t, []), key=lambda kv: kv[1], reverse=True)[:args.show]
        rows.append((
            datetime.fromtimestamp(t, timezone.utc).astimezone().strftime("%m-%d %H:%M"),
            f"{lv:.1f}x",
            f"{float(stall_pts.get(t, 0)) * 100:.0f}%",
            ", ".join(f"{g} {human_bytes(v) if fmt is None else fmt.format(v)}" for g, v in who) or "-",
        ))

    if args.json:
        print(json.dumps([dict(zip(("time", "load_per_cpu", "io_stall", "top"), r)) for r in rows], indent=2))
        return 0

    print(f"load and its owners, {args.since} back, {step} buckets, ranked by {args.by}")
    if args.min_load:
        print(f"(only buckets where load >= {args.min_load}x cores)")
    print()
    print(table(rows, ("time", "load", "io-stall", f"top {args.show} by {args.by}")))
    return 0


def cmd_where(args) -> int:
    root, how = stack_root()
    compose = (root / "docker-compose.yml").is_file()
    info = {"root": str(root), "resolved_by": how, "prometheus": PROM,
            "grafana": "http://localhost:13337", "compose_file": compose}
    if args.json:
        print(json.dumps(info, indent=2))
        return 0
    if args.quiet:
        print(root)
        return 0
    print(f"stack root   {root}")
    print(f"resolved by  {how}")
    print(f"prometheus   {PROM}")
    print(f"grafana      http://localhost:13337")
    if not compose:
        print("\nNo docker-compose.yml there. Clone the stack and set RIG_TELEMETRY_HOME:")
        print("  git clone https://github.com/api-haus/rig-telemetry")
        return 1
    return 0


# --------------------------------------------------------------------------
# rig containers — per compose stack, or per container
# --------------------------------------------------------------------------

STACK_BY = {
    "cpu": ("rig:stack:cpu_cores", "rig:container:cpu_cores", "cores", "{:.3f}"),
    "mem": ("rig:stack:rss_bytes", "rig:container:rss_bytes", "resident", None),
    "swap": ("rig:stack:swap_bytes", "rig:container:swap_bytes", "swapped out", None),
    "io": ("rig:stack:io_bytes_per_sec", "rig:container:io_bytes_per_sec", "bytes/s", None),
}


def cmd_containers(args) -> int:
    key = "name" if args.each else "project"
    rows: dict[str, dict[str, float]] = {}
    for dim, (stack_m, each_m, _unit, _fmt) in STACK_BY.items():
        metric = each_m if args.each else stack_m
        expr = f"{args.agg}_over_time({metric}[{args.since}])" if args.since else metric
        for name, value in series(expr, key, args.at):
            rows.setdefault(name, {})[dim] = value
    if not args.each:
        for name, value in series("rig:stack:containers", "project", args.at):
            rows.setdefault(name, {})["count"] = value

    order = sorted(rows.items(), key=lambda kv: -kv[1].get(args.sort, 0))[:args.top]
    if args.json:
        print(json.dumps([{key: n, **v} for n, v in order], indent=2))
        return 0

    header = ("stack", "containers", "cpu", "resident", "swapped", "io")
    if args.each:
        header = ("container", "cpu", "resident", "swapped", "io")
    out = []
    for n, v in order:
        cells = [f"{v.get('cpu', 0):.3f}", human_bytes(v.get("mem", 0)),
                 human_bytes(v.get("swap", 0)), human_bytes(v.get("io", 0)) + "/s"]
        out.append((n, f"{v.get('count', 0):.0f}", *cells) if not args.each else (n, *cells))

    window_note = f"{args.agg} over {args.since}" if args.since else "now"
    print(f"docker {'containers' if args.each else 'stacks'}, sorted by {args.sort} — {window_note}\n")
