#!/usr/bin/env python3
"""rig — read the telemetry stack from a terminal or an agent.

Every subcommand takes --json for machine consumption and --at/--since to ask
about the past instead of now. Python standard library only, on purpose: this
has to keep working when the thing it is diagnosing is broken.

See AGENTS.md for the query vocabulary.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

PROM = os.environ.get("RIG_PROMETHEUS", "http://127.0.0.1:13390")
TIMEOUT = float(os.environ.get("RIG_TIMEOUT", "30"))
HERE = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "tools"))


def stack_root() -> tuple[pathlib.Path, str]:
    """Where the stack lives, and how that was determined.

    A running stack wins over this checkout: the same `rig` may be invoked from
    a plugin copy while the compose project was started from a clone elsewhere,
    and `docker compose` commands have to reach the one that is actually up.
    """
    env = os.environ.get("RIG_TELEMETRY_HOME")
    if env and (pathlib.Path(env) / "docker-compose.yml").is_file():
        return pathlib.Path(env), "RIG_TELEMETRY_HOME"
    try:
        out = subprocess.run(
            ["docker", "inspect", "rig-prometheus", "--format",
             '{{index .Config.Labels "com.docker.compose.project.working_dir"}}'],
            capture_output=True, text=True, timeout=10)
        path = pathlib.Path(out.stdout.strip())
        if out.returncode == 0 and out.stdout.strip() and (path / "docker-compose.yml").is_file():
            return path, "running stack"
    except (OSError, subprocess.SubprocessError):
        pass
    return HERE, "this checkout"

UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800, "y": 31536000}


# --------------------------------------------------------------------------
# prometheus access
# --------------------------------------------------------------------------

class PromError(RuntimeError):
    pass


def _call(path: str, params: dict, method: str = "POST") -> dict:
    url = f"{PROM}/api/v1/{path}"
    if method == "GET":
        req = urllib.request.Request(f"{url}?{urllib.parse.urlencode(params)}")
    else:
        req = urllib.request.Request(url, data=urllib.parse.urlencode(params).encode(), method="POST")
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        raise PromError(f"{e.code} from {url}: {e.read()[:400].decode(errors='replace')}") from e
    except urllib.error.URLError as e:
        root, _ = stack_root()
        raise PromError(
            f"cannot reach Prometheus at {PROM}: {e.reason}\n"
            f"  the stack is not running. start it with:\n"
            f"    cd {root} && docker compose up -d\n"
            f"  point elsewhere with RIG_PROMETHEUS=http://host:port") from e
    if body.get("status") != "success":
        raise PromError(f"{body.get('errorType')}: {body.get('error')}")
    return body["data"]


def query(expr: str, at: str | None = None) -> list[dict]:
    params = {"query": expr}
    if at:
        params["time"] = at
    return _call("query", params)["result"]


def query_range(expr: str, start: str, end: str, step: str) -> list[dict]:
    return _call("query_range", {"query": expr, "start": start, "end": end, "step": step})["result"]


def scalar(expr: str, at: str | None = None, default=None):
    """First sample of an instant query, as a float."""
    res = query(expr, at)
    if not res:
        return default
    try:
        return float(res[0]["value"][1])
    except (KeyError, IndexError, ValueError):
        return default


def series(expr: str, label: str, at: str | None = None) -> list[tuple[str, float]]:
    """Instant query flattened to (label_value, value), largest first."""
    out = []
    for s in query(expr, at):
        name = s["metric"].get(label) or s["metric"].get("__name__") or "?"
        try:
            out.append((name, float(s["value"][1])))
        except (KeyError, IndexError, ValueError):
            continue
    return sorted(out, key=lambda kv: kv[1], reverse=True)


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------

def human_bytes(n: float | None) -> str:
    if n is None:
        return "n/a"
    for unit in ("B", "K", "M", "G", "T", "P"):
        if abs(n) < 1024:
            return f"{n:.1f}{unit}" if unit != "B" else f"{n:.0f}B"
        n /= 1024
    return f"{n:.1f}E"


def num(v, fmt="{:.2f}", dash="n/a") -> str:
    return dash if v is None else fmt.format(v)


def pct(v) -> str:
    return "n/a" if v is None else f"{v * 100:.1f}%"


def rule(title: str = "", width: int = 74) -> str:
    if not title:
        return "-" * width
    return f"-- {title} " + "-" * max(0, width - len(title) - 4)


def table(rows: list[tuple], headers: tuple, indent: str = "  ") -> str:
    if not rows:
        return indent + "(nothing)"
    cols = list(zip(*([headers] + [tuple(str(c) for c in r) for r in rows])))
    widths = [max(len(str(c)) for c in col) for col in cols]
    out = [indent + "  ".join(str(h).ljust(w) for h, w in zip(headers, widths)).rstrip()]
    out.append(indent + "  ".join("-" * w for w in widths))
    for r in rows:
        out.append(indent + "  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def parse_duration(text: str) -> timedelta:
    text = text.strip()
    if text and text[-1] in UNITS and text[:-1].replace(".", "", 1).isdigit():
        return timedelta(seconds=float(text[:-1]) * UNITS[text[-1]])
    raise SystemExit(f"rig: bad duration {text!r}; use 30m, 6h, 7d, 2w")


def window(args) -> tuple[str, str, str]:
    """(start, end, step) as RFC3339 strings for the range API."""
    end = datetime.fromisoformat(args.at.replace("Z", "+00:00")) if getattr(args, "at", None) \
        else datetime.now(timezone.utc)
    span = parse_duration(args.since)
    start = end - span
    step = getattr(args, "step", None) or f"{max(15, int(span.total_seconds() // 400))}s"
    return start.isoformat(), end.isoformat(), step


