def cmd_ai_limits(args) -> int:
    """What is left of each subscription, asked of the seller that meters it.

    A plan is metered on the seller's side, across every device the account is
    signed in on, so the figure comes from the seller rather than from the
    tokens counted here. `--at` reads the recorded series instead, which is the
    only way to ask what a window looked like at some earlier moment.
    """
    if args.at:
        return _limits_recorded(args)
    hq = _quota()
    rows, raw, notes = [], [], []
    for q in hq.read_all(max_age=0 if args.refresh else hq.MAX_AGE):
        # Shortest window first; one whose length the seller never declared last.
        for w in sorted(q.windows, key=lambda w: (w.seconds or 1e12, w.label)):
            rows.append((q.harness, q.plan, w.label, pct(w.used), pct(1 - w.used),
                         _in(w.resets_at), _ago(q.measured),
                         q.source + (" (stale)" if q.stale else "")))
            raw.append({"harness": q.harness, "plan": q.plan, "window": w.label,
                        "used_ratio": w.used, "left_ratio": 1 - w.used,
                        "resets_at": w.resets_at, "window_seconds": w.seconds,
                        "measured": q.measured, "source": q.source, "stale": q.stale})
        if q.error:
            notes.append(f"{q.harness}: {q.error}")
            raw.append({"harness": q.harness, "error": q.error})
    if args.json:
        print(json.dumps(raw, indent=2))
        return 0
    if rows:
        print(table(rows, ("harness", "plan", "window", "used", "left", "resets in",
                           "measured", "from")))
    for note in notes:
        print(f"  {note}")
    if not rows and not notes:
        print("  no subscription on this machine publishes a window.")
    return 0


def _limits_recorded(args) -> int:
    """The same table out of Prometheus, which is what `--at` can reach."""
    rows = []
    for s in query("aiusage_rate_limit_used_ratio", args.at):
        m = s["metric"]
        where = ",".join(f'{k}="{m.get(k)}"' for k in ("harness", "window", "plan", "source"))
        reset = scalar(f"aiusage_rate_limit_reset_timestamp_seconds{{{where}}}", args.at)
        seen = scalar(f'aiusage_rate_limit_seen_timestamp_seconds{{harness="{m.get("harness")}"'
                      f',plan="{m.get("plan")}",source="{m.get("source")}"}}', args.at)
        used = float(s["value"][1])
        # Shortest window first, the way the live table orders them.
        rank = scalar(f"aiusage_rate_limit_window_seconds{{{where}}}", args.at)
        rows.append(((m.get("harness", "?"), rank or 1e12, m.get("window", "?")),
                     (m.get("harness", "?"), m.get("plan", "?"), m.get("window", "?"),
                      pct(used), pct(1 - used), _in(reset), _ago(seen), m.get("source", "?")),
                     {"harness": m.get("harness"), "plan": m.get("plan"),
                      "window": m.get("window"), "used_ratio": used, "left_ratio": 1 - used,
                      "resets_at": reset, "window_seconds": rank, "measured": seen,
                      "source": m.get("source")}))
    rows.sort()
    if args.json:
        print(json.dumps([r[2] for r in rows], indent=2))
        return 0
    rows = [r[1] for r in rows]
    print(table(rows, ("harness", "plan", "window", "used", "left", "resets in",
                       "measured", "from")))
    return 0


def _quota():
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
    import harness_quota
    return harness_quota


def _in(when: float | None) -> str:
    """How long until a moment, or that it has already passed."""
    if not when:
        return "-"
    left = when - datetime.now(timezone.utc).timestamp()
    return "elapsed" if left <= 0 else str(timedelta(seconds=int(left)))


def _ago(when: float | None) -> str:
    if not when:
        return "-"
    return str(timedelta(seconds=int(datetime.now(timezone.utc).timestamp() - when))) + " ago"


def cmd_ai_scan(args) -> int:
    """Read new session files into the ledger without the container."""
    hu, db = _ledger(args, write=True)
    if args.fetch_prices:
        print(f"prices: {hu.fetch_catalogue()} providers from models.dev")
    prices = hu.Prices()
    result = hu.scan(db, prices, only=args.harness or "")
    print(f"scanned {sum(result.files.values())} files in {result.seconds:.1f}s, "
          f"{result.records:,} new records, {result.errors} unreadable")
    print(table(sorted(result.files.items()), ("harness", "files")))
    for problem in result.problems:
        print(f"  ! {problem}")
    return 0


def _ai_verify(hu, db) -> int:
    """Recount straight from the files and compare with the ledger.

    The ledger is an accumulator, and an accumulator's failure mode is adding
    the same thing twice — which stays perfectly consistent and so reads as
    real usage. This is the independent count that catches it.
    """
    print(rule("recounting every session file"))
    # Scan first, so anything the ledger is missing is genuinely in flight
    # rather than a reader that stopped an hour ago.
    hu.scan(db, hu.Prices(hu.load_catalogue(refresh=False)))
    seen: set[str] = set()
    found: dict[str, list[int]] = {}
    for cls in hu.SOURCES:
        src = cls()
        for path in src.files():
            try:
                gen = src.parse(path, 0, {})
                while True:
                    try:
                        rec = next(gen)
                    except StopIteration:
                        break
                    if rec.uid is not None:
                        if f"{src.name}:{rec.uid}" in seen:
                            continue
                        seen.add(f"{src.name}:{rec.uid}")
                    acc = found.setdefault(src.name, [0, 0])
                    acc[0] += rec.requests
                    acc[1] += sum(getattr(rec, r) for r in hu.BILLED_ROLES)
            except (OSError, ValueError):
                continue

    # A ledger *behind* the files is the normal state: sessions append while
    # this runs, and the recount finishes after the scan did. A ledger *ahead*
    # of them can only mean something was added twice.
    rows, ahead, behind = [], 0, 0
    ledger = {r["harness"]: r for r in hu.totals(db, ("harness",))}
    for harness in sorted(set(found) | set(ledger)):
        want = found.get(harness, [0, 0])
        have = ledger.get(harness)
        got = [int(have["requests"]), int(sum(have[r] for r in hu.BILLED_ROLES))] if have else [0, 0]
        drift = got[0] - want[0]
        ahead += max(0, drift)
        behind += max(0, -drift)
        verdict = "ok" if drift == 0 else (
            f"AHEAD by {drift:,} ({got[0] / max(want[0], 1):.2f}x)" if drift > 0
            else f"{-drift:,} in flight")
        rows.append((harness, f"{want[0]:,}", f"{got[0]:,}", toks(want[1]), toks(got[1]), verdict))
    print(table(rows, ("harness", "in the files", "in the ledger", "tokens", "ledger tokens", "")))
    if ahead:
        print(f"\n  The ledger holds {ahead:,} responses the files do not. Something was")
        print("  counted twice. Rebuild it:")
        print(f"    rm {hu.ledger_path()}* && rig ai scan")
        return 1
    if behind:
        print(f"\n  {behind:,} responses landed while this was counting. Nothing double counted.")
    else:
        print("\n  Every harness agrees to the token.")
    return 0


def _hour_ranges(hours) -> str:
    """Hours back as the half-open clock ranges they were written as."""
    spans, start = [], None
    for hour in list(hours) + [None]:
        if start is None:
            start = last = hour
        elif hour == last + 1:
            last = hour
        else:
            spans.append(f"{start:02d}-{last + 1:02d}")
            start = last = hour
    return ",".join(spans)


def _clocked_rates(hu) -> None:
    """Every rate that moves on a calendar or a clock, and when it moves.

    A price that changes at 16:00 on a Sunday is the one nobody can see in a
    total, so it is stated here rather than left to be inferred from a bill.
    """
    rows = []
    for key, lines in sorted(hu.load_overrides().items()):
        for value, source, _, name in lines:
            try:
                head, clause = hu.split_clauses(value)
            except ValueError:
                continue
            if clause["from"] is None and clause["at"] is None:
                continue
            hours = _hour_ranges(clause["at"]) if clause["at"] else "every hour"
            start = datetime.fromtimestamp(clause["from"], timezone.utc) if clause["from"] else None
            rows.append((name, head,
                         start.strftime("%Y-%m-%d %H:%MZ") if start else "always",
                         hours, clause["on"] or "any provider",
                         pathlib.Path(source).name if source != "environment" else source))
    if rows:
        print()
        print(rule("rates that move on a clock"))
        print(table(rows, ("model", "$/M in/read/write/out", "from", "UTC hours",
                           "provider", "stated in")))


def _at_hour(after: float, hour: int) -> float:
    """The first `hour` UTC comfortably after an instant."""
    day = datetime.fromtimestamp(after, timezone.utc) + timedelta(days=1)
    return day.replace(hour=hour, minute=0, second=0, microsecond=0).timestamp()


def _next_change(prices, provider: str, model: str, now: float) -> tuple[float, dict] | None:
    """The next instant this model bills at a rate other than the one in force.

    Walked hour by hour rather than reasoned about, because a clock and a start
    date can both land on the same hour and only the lookup knows which wins.
    """
    rates = lambda r: r and tuple(r[k] for k in ("input", "cache_read", "cache_write", "output"))
    now_on = rates(prices.lookup(provider, model, now))
    top = datetime.fromtimestamp(now, timezone.utc).replace(minute=0, second=0, microsecond=0)
    for ahead in range(1, 24 * 8 + 1):
        moment = (top + timedelta(hours=ahead)).timestamp()
        later = prices.lookup(provider, model, moment)
        if rates(later) != now_on:
            return moment, later
    return None


def _local_hours(hours: tuple[int, ...], when: float) -> str:
    """A fixed UTC window as the wall clock reads it, at that date's offset.

    Taken from the offset in force at `when` rather than from a stored one:
    where the clock changes twice a year, a window fixed in UTC is not fixed
    on the wall, and a half-year-old offset renders it an hour wrong.
    """
    shift = datetime.fromtimestamp(when, timezone.utc).astimezone().utcoffset()
    moved = round(shift.total_seconds() / 3600) if shift else 0
    return _hour_ranges(tuple(sorted({(h + moved) % 24 for h in hours})))


def cmd_ai_clock(args) -> int:
    """What a seller's peak window costs, at this machine's own working hours.

    A headline rate change says nothing on its own. What decides the bill is
    which role's rate moved and how much of your traffic is that role: nearly
    every token an agent sends is a cache read, so a cache-read rate is the
    whole invoice and the input rate is a rounding error.
    """
    hu, db = _ledger(args)
    prices = hu.Prices()
    span = args.hours * args.days

    # Which hours you work decides the exposure, so it is measured, not assumed.
    spend, live = {}, {}
    for row in hu.totals(db, ("provider", "model", "utc_slot"), prices=prices):
        hour = int(row["utc_slot"][-2:])
        spend[hour] = spend.get(hour, 0.0) + row["cost"]
        seen = live.setdefault((row["provider"], row["model"]), [0, 0.0])
        seen[0] += 1
        seen[1] += row["cost"]
    recorded = sum(spend.values()) or 1.0

    found = []
    for row in sorted(hu.totals(db, ("provider", "model"), prices=prices), key=lambda r: -r["cost"]):
        provider, model = row["provider"], row["model"]
        moves = prices.clock(provider, model)
        if not moves:
            continue
        hours, start = moves
        was = prices.lookup(provider, model, start - 1)
        off = prices.lookup(provider, model, _at_hour(start, next(h for h in range(24)
                                                                 if h not in hours)))
        top = prices.lookup(provider, model, _at_hour(start, hours[0]))
        mix = {role: row[role] for role in hu.BILLED_ROLES}
        bill = lambda r: sum(mix[k] * r[k] for k in hu.BILLED_ROLES) / 1e6
        if not (was and off and top) or not bill(was):
            continue
        exposure = sum(v for h, v in spend.items() if h in hours) / recorded
        old, cheap, dear = bill(was), bill(off), bill(top)
        slots, cost = live[(provider, model)]
        now = time.time()
        turns = _next_change(prices, provider, model, now)
        found.append({
            "next_change": turns and {
                "at": turns[0], "in_seconds": turns[0] - now,
                "tier": "peak" if datetime.fromtimestamp(turns[0], timezone.utc).hour in hours
                        else "off-peak",
                "rates": turns[1],
            },
            "provider": provider, "model": model, "starts": start,
            "peak_hours_utc": _hour_ranges(hours),
            "peak_hours_local": _local_hours(hours, time.time()),
            "peak_hours_local_other_half_year": _local_hours(hours, time.time() + 182 * 86400),
            "rates": {"was": was, "off_peak": off, "peak": top},
            "tokens": mix, "repriced": {"was": old, "off_peak": cheap, "peak": dear},
            "peak_exposure": exposure,
            "blend": exposure * (dear / old) + (1 - exposure) * (cheap / old),
            "measured_hours": slots, "usd_per_hour": cost / max(slots, 1),
        })

    if args.json:
        print(json.dumps({"session_hours": args.hours, "days": args.days,
                          "models": found}, indent=2))
        return 0
    if not found:
        print("  no model on this machine is sold on a clock.")
        print("  share/prices.tsv documents the `at` clause that would say so.")
        return 0

    for f in found:
        was, off, top = (f["rates"][k] for k in ("was", "off_peak", "peak"))
        mix, priced = f["tokens"], f["repriced"]
        print()
        print(rule(f"{f['model']} on {f['provider']}"))
        print(f"  peak {f['peak_hours_utc']} UTC — {f['peak_hours_local']} {time.strftime('%Z')}"
              f" — from {datetime.fromtimestamp(f['starts'], timezone.utc):%Y-%m-%d %H:%MZ}")
        if f["peak_hours_local_other_half_year"] != f["peak_hours_local"]:
            print(f"  The window is fixed in UTC, so daylight saving moves it here: "
                  f"{f['peak_hours_local_other_half_year']} for the other half of the year.")
        turns = f["next_change"]
        if turns:
            r, when = turns["rates"], datetime.fromtimestamp(turns["at"], timezone.utc)
            print(f"  next change {when:%Y-%m-%d %H:%MZ} — {when.astimezone():%H:%M %Z}, in "
                  f"{timedelta(seconds=int(turns['in_seconds']))} — {turns['tier']} rate, "
                  f"{r['input']:g}/{r['cache_read']:g}/{r['cache_write']:g}/{r['output']:g}")
        print()
        print(table([(r, f"{was[r]:g}", f"{off[r]:g}", f"{top[r]:g}",
                      f"{off[r] / was[r]:.2f}x" if was[r] else "-",
                      f"{top[r] / was[r]:.2f}x" if was[r] else "-",
                      toks(mix[r]), money(mix[r] * was[r] / 1e6),
                      money(mix[r] * off[r] / 1e6), money(mix[r] * top[r] / 1e6))
                     for r in hu.BILLED_ROLES],
                    ("role", "$/M was", "off-peak", "peak", "off x", "peak x",
                     "your tokens", "was", "at off-peak", "at peak")))
        print(f"\n  Everything recorded for this model, repriced: {money(priced['was'])} becomes "
              f"{money(priced['off_peak'])} off-peak and {money(priced['peak'])} at peak.")
        print(f"  {pct(f['peak_exposure'])} of this machine's spend lands in those hours, "
              f"so the blend is {f['blend']:.2f}x.")

    print()
    print(rule(f"{args.hours:g}h a day, {args.days} days"))
    print(table([(f["model"], f"{f['measured_hours']}h", money(f["usd_per_hour"]),
                  money(f["usd_per_hour"] * span), money(f["usd_per_hour"] * span * f["blend"]),
                  f"{f['blend']:.2f}x") for f in found],
                ("model", "measured over", "$/h now", f"{span:g}h now",
                 f"{span:g}h after", "blend")))
    print("\n  `$/h now` is this machine's own measured burn for that model, at the rate")
    print("  in force when the tokens were sent. It is a rate, not a forecast.")
    return 0


