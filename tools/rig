def cmd_thermals(args) -> int:
    at = args.at
    temps = series("rig:temp_celsius", "label", at)
    named = []
    for s in query("rig:temp_celsius", at):
        m = s["metric"]
        named.append((m.get("chip_name", "?"), m.get("label") or m.get("sensor", "?"),
                      float(s["value"][1])))
    named.sort(key=lambda r: (-r[2], r[0]))

    health = {
        "ambient_c": scalar("rig:ambient_celsius", at),
        "cpu_c": scalar("rig:cpu_celsius", at),
        "gpu_c": scalar("rig:gpu_celsius", at),
        "gpu_w": scalar("rig:gpu_watts", at),
        "gpu_fan": scalar("rig:thermal:gpu_fan_ratio", at),
        "gpu_headroom_c": scalar("rig:thermal:gpu_headroom_c", at),
        "pump_rpm": scalar("rig:thermal:pump_rpm", at),
        "coolant_rise_c": scalar("rig:thermal:coolant_rise_c", at),
        "coolant_delta_c": scalar("rig:thermal:coolant_delta_c", at),
        "die_to_coolant_c": scalar("rig:thermal:die_to_coolant_c", at),
        "gpu_resistance": scalar("rig:thermal:gpu_resistance_c_per_w", at),
    }
    degradation = {
        "gpu cooler (dust)": ("rig:thermal:gpu_degradation_ratio", 1.15),
        "radiator (dust)": ("rig:thermal:radiator_degradation_ratio", 1.20),
        "cpu path overall": ("rig:thermal:cpu_degradation_ratio", 1.20),
        "cold plate / paste": ("rig:thermal:mount_degradation_ratio", 1.20),
    }
    deg_rows, deg_json = [], {}
    for name, (expr, threshold) in degradation.items():
        v = scalar(expr, at)
        deg_json[name] = v
        if v is None:
            deg_rows.append((name, "no baseline yet", "needs 37d of history"))
        else:
            worse = (v - 1) * 100
            deg_rows.append((name, f"{worse:+.1f}%",
                             "CLEAN IT" if v > threshold else "ok"))

    if args.json:
        print(json.dumps({"health": health, "degradation": deg_json,
                          "sensors": [{"chip": c, "sensor": s, "celsius": v} for c, s, v in named]},
                         indent=2))
        return 0

    print(rule("now"))
    print(f"  case air (reference) {num(health['ambient_c'], '{:.0f}')}C")
    print(f"  cpu {num(health['cpu_c'], '{:.0f}')}C"
          f"   = {num(health['die_to_coolant_c'], '{:.0f}')}C over coolant (mount)"
          f" + {num(health['coolant_rise_c'], '{:.0f}')}C over air (radiator)")
    print(f"  loop delta {num(health['coolant_delta_c'], '{:.1f}')}C"
          f"   pump/fan {num(health['pump_rpm'], '{:.0f}')} rpm")
    print(f"  gpu {num(health['gpu_c'], '{:.0f}')}C at {num(health['gpu_w'], '{:.0f}')}W,"
          f" fan {pct(health['gpu_fan'])}, {num(health['gpu_headroom_c'], '{:.0f}')}C from throttling")
    if health["gpu_resistance"] is not None:
        print(f"  gpu thermal resistance {health['gpu_resistance']:.3f} C/W")
    else:
        print("  gpu thermal resistance: idle (needs >=60W to measure)")
    print()
    print(rule("cooling vs. one month ago"))
    print(table(deg_rows, ("path", "change", "verdict")))
    print()
    print(rule("all sensors"))
    print(table([(c, s, f"{v:.1f}C") for c, s, v in named], ("chip", "sensor", "temp")))
    return 0


