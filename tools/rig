                  f"{r['cost'] / max(total['cost'], 1e-9) * 100:.0f}%") for r in by_kind],
                ("", "list value", "share")))
    gap = hu.unpriced(db, prices)
    if gap:
        print()
        print(rule("no published price — excluded from every figure above"))
        print(table([(r["harness"], r["model"], toks(r["tokens"])) for r in gap],
                    ("harness", "model", "tokens")))
    return 0


def _role_costs(hu, db, since: str, prices):
    """Cost per token role, priced the same way the exporter prices it."""
    acc: dict[str, list[float]] = {}
    for row in hu.totals(db, ("provider", "model"), since=since, prices=prices):
        for role in hu.BILLED_ROLES:
            cell = acc.setdefault(role, [0.0, 0.0])
            cell[0] += row[f"cost_{role}"]
            cell[1] += row[role]
    return sorted(((role, c, t) for role, (c, t) in acc.items()), key=lambda r: -r[1])


