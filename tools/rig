def cmd_ai_limits(args) -> int:
    """Subscription windows, straight from the harness that publishes them.

    A harness writes these only while it is running, so an idle one leaves a
    figure that was true when it last ran. The measurement time is a column
    rather than a footnote, because a window that reset hours ago reads as
    fully used until the harness runs again.
    """
    now = datetime.now(timezone.utc).timestamp()
    rows = []
    for s in query("aiusage_rate_limit_used_ratio", args.at):
        m = s["metric"]
        where = f'{{harness="{m.get("harness")}",window="{m.get("window")}"}}'
        reset = scalar(f"aiusage_rate_limit_reset_timestamp_seconds{where}", args.at)
        seen = scalar(f'aiusage_rate_limit_seen_timestamp_seconds{{harness="{m.get("harness")}"}}',
                      args.at)
        span = lambda v: "-" if v is None else str(timedelta(seconds=int(abs(v))))
        rows.append((m.get("harness", "?"), m.get("plan", "?"), m.get("window", "?"),
                     pct(float(s["value"][1])),
                     "elapsed" if reset and reset < now else span(reset and reset - now),
                     span(seen and now - seen) + " ago" if seen else "-"))
    if args.json:
        print(json.dumps([dict(zip(("harness", "plan", "window", "used", "resets_in", "measured"), r))
                          for r in rows], indent=2))
        return 0
    print(table(rows, ("harness", "plan", "window", "used", "resets in", "measured")))
    if not rows:
        print("  no harness on this machine publishes its subscription window.")
    else:
        print("\n  Read only while the harness runs. An `elapsed` window has reset since.")
    return 0


