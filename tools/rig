def cmd_disk(args) -> int:
    at = args.at
    util = dict(series("rig:disk:util_ratio", "device", at))
    r_aw = dict(series("rig:disk:read_await_seconds", "device", at))
    w_aw = dict(series("rig:disk:write_await_seconds", "device", at))
    d_aw = dict(series("rig:disk:discard_await_seconds", "device", at))
    rd = dict(series("rig:disk:read_bytes_per_sec", "device", at))
    wr = dict(series("rig:disk:write_bytes_per_sec", "device", at))
    ms = lambda v: "-" if v is None else f"{v * 1000:.2f}ms"
    rows = [(d, pct(util.get(d)),
             ms(r_aw.get(d)), ms(w_aw.get(d)), ms(d_aw.get(d)),
             human_bytes(rd.get(d, 0)) + "/s", human_bytes(wr.get(d, 0)) + "/s")
            for d in sorted(util, key=lambda k: -util[k])]

    # One device shows up under every subvolume and bind mount it carries.
    # Collapse to one row per device, named by its shortest mountpoint.
    by_dev: dict[str, tuple[str, float, int]] = {}
    for s in query("rig:fs:used_ratio", at):
        dev = s["metric"].get("device", "?")
        mp = s["metric"].get("mountpoint", "?")
        prev = by_dev.get(dev)
        aliases = (prev[2] if prev else 0) + 1
        if prev is None or len(mp) < len(prev[0]):
            by_dev[dev] = (mp, float(s["value"][1]), aliases)
        else:
            by_dev[dev] = (prev[0], prev[1], aliases)
    avail = {s["metric"].get("device", "?"): float(s["value"][1]) for s in query("rig:fs:avail_bytes", at)}
    fs_rows = [(mp, dev, pct(v), human_bytes(avail.get(dev)), n - 1)
               for dev, (mp, v, n) in sorted(by_dev.items(), key=lambda kv: -kv[1][1])]

    # Keyed by serial, not by smartctl's `device`: that is a scan index and it
    # moves between drives, so a device-keyed row can name the wrong disk.
    def drive(s):
        return (s["metric"].get("model_name", "?"), s["metric"].get("serial_number", "?"))

    wear = [(drive(s), float(s["value"][1])) for s in query("rig:drive:wear_ratio", at)]
    temp = {drive(s): float(s["value"][1]) for s in query("rig:drive:temp_celsius", at)}
    err = {drive(s): float(s["value"][1]) for s in query("rig:drive:media_errors", at)}
    smart_rows = [(model, serial, f"{v * 100:.0f}%", f"{temp.get((model, serial), 0):.0f}C",
                   f"{err.get((model, serial), 0):.0f}")
                  for (model, serial), v in sorted(wear, key=lambda kv: -kv[1])]

    if args.json:
        print(json.dumps({"io": rows, "filesystems": fs_rows, "smart": smart_rows}, indent=2))
        return 0
    print(rule("io"))
    print(table(rows, ("device", "busy", "r-await", "w-await", "trim-await", "read", "write")))
    print()
    print(rule("filesystems"))
    print(table(fs_rows, ("mount", "device", "used", "free", "other mounts")))
    print()
    print(rule("smart"))
    print(table(smart_rows, ("drive", "serial", "wear", "temp", "media errors")))
    return 0


