def cmd_disk(args) -> int:
    at = args.at
    util = dict(series("rig:disk:util_ratio", "device", at))
    await_s = dict(series("rig:disk:await_seconds", "device", at))
    rd = dict(series("rig:disk:read_bytes_per_sec", "device", at))
    wr = dict(series("rig:disk:write_bytes_per_sec", "device", at))
    rows = [(d, pct(util.get(d)), f"{await_s.get(d, 0) * 1000:.1f}ms",
             human_bytes(rd.get(d, 0)) + "/s", human_bytes(wr.get(d, 0)) + "/s")
            for d in sorted(util, key=lambda k: -util[k])]

    # One device shows up under every subvolume and bind mount it carries.
    # Collapse to one row per device, named by its shortest mountpoint.
    by_dev: dict[str, tuple[str, float, int]] = {}
    for s in query("rig:fs:used_ratio", at):
        dev = s["metric"].get("device", "?")
        mp = s["metric"].get("mountpoint", "?")
        prev = by_dev.get(dev)
        aliases = (prev[2] if prev else 0) + 1
        if prev is None or len(mp) < len(prev[0]):
            by_dev[dev] = (mp, float(s["value"][1]), aliases)
        else:
            by_dev[dev] = (prev[0], prev[1], aliases)
    avail = {s["metric"].get("device", "?"): float(s["value"][1]) for s in query("rig:fs:avail_bytes", at)}
    fs_rows = [(mp, dev, pct(v), human_bytes(avail.get(dev)), n - 1)
               for dev, (mp, v, n) in sorted(by_dev.items(), key=lambda kv: -kv[1][1])]

    wear = [(s["metric"].get("device", "?"), float(s["value"][1])) for s in query("smartctl_device_percentage_used", at)]
    temp = {s["metric"].get("device", "?"): float(s["value"][1]) for s in query("smartctl_device_temperature", at)}
    err = {s["metric"].get("device", "?"): float(s["value"][1]) for s in query("smartctl_device_media_errors", at)}
    smart_rows = [(d, f"{v:.0f}%", f"{temp.get(d, 0):.0f}C", f"{err.get(d, 0):.0f}") for d, v in wear]

    if args.json:
        print(json.dumps({"io": rows, "filesystems": fs_rows, "smart": smart_rows}, indent=2))
        return 0
    print(rule("io"))
    print(table(rows, ("device", "busy", "await", "read", "write")))
    print()
    print(rule("filesystems"))
    print(table(fs_rows, ("mount", "device", "used", "free", "other mounts")))
    print()
    print(rule("smart"))
    print(table(smart_rows, ("device", "wear", "temp", "media errors")))
    return 0


def cmd_alerts(args) -> int:
    data = _call("query", {"query": 'ALERTS{alertstate=~"firing|pending"}'})["result"]
    fixed = {"__name__", "alertname", "alertstate", "severity", "domain", "action", "host", "instance", "job"}
    rows = []
    for s in data:
        m = s["metric"]
        subject = ",".join(f"{v}" for k, v in sorted(m.items()) if k not in fixed) or "-"
        rows.append((m.get("alertname", "?"), m.get("alertstate", "?"),
                     m.get("severity", "-"), m.get("domain", "-"), subject))
    rows = sorted(set(rows), key=lambda r: (r[1] != "firing", r[2] != "critical", r[0]))
    if args.json:
        print(json.dumps([dict(zip(("alert", "state", "severity", "domain", "subject"), r)) for r in rows], indent=2))
        return 0
    print(table(rows, ("alert", "state", "severity", "domain", "subject")) if rows else "  nothing firing")
    return 0


def cmd_health(args) -> int:
    # The targets API reflects the live scrape config. The `up` metric also
    # carries series for targets that have gone away but are not yet stale.
    active = _call("targets", {"state": "any"}, method="GET")["activeTargets"]
    trows = sorted((t["labels"].get("job", "?"),
                    t["scrapeUrl"].split("//")[-1].split("/")[0],
                    t["health"],
                    (t.get("lastError") or "")[:60]) for t in active)
    with urllib.request.urlopen(f"{PROM}/api/v1/rules", timeout=TIMEOUT) as r:
        groups = json.load(r)["data"]["groups"]
    bad = [(rl["name"], rl.get("lastError", "")) for g in groups for rl in g["rules"]
           if rl.get("health") == "err"]
    pending = sum(1 for g in groups for rl in g["rules"] if rl.get("health") == "unknown")
    samples = scalar("prometheus_tsdb_head_samples_appended_total")
    sser = scalar("prometheus_tsdb_head_series")
    oldest = scalar("(time() - (prometheus_tsdb_lowest_timestamp / 1000)) / 86400")

    if args.json:
        print(json.dumps({"targets": trows, "rule_errors": bad, "rules_not_yet_evaluated": pending,
                          "head_series": sser, "history_days": oldest}, indent=2))
        return 0
    print(rule("scrape targets"))
    print(table(trows, ("job", "endpoint", "state", "error")))
    print()
    print(rule("rules"))
    print(f"  {sum(len(g['rules']) for g in groups)} rules, {len(bad)} failing, "
          f"{pending} not yet evaluated (slow groups)")
    for n, e in bad:
        print(f"  ERR {n}: {e}")
    print()
    print(rule("storage"))
    print(f"  {num(sser, '{:.0f}')} active series, {num(oldest, '{:.1f}')} days of history retained")
    return 0


# --------------------------------------------------------------------------
# rig q / range / metrics
# --------------------------------------------------------------------------

def cmd_q(args) -> int:
    res = query(args.expr, args.at)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    if not res:
        print("  (empty result)")
        return 0
    keys = sorted({k for s in res for k in s["metric"] if k != "__name__"})
    rows = [tuple([s["metric"].get(k, "") for k in keys] + [s["value"][1]]) for s in res]
    rows.sort(key=lambda r: -float(r[-1]) if r[-1] not in ("NaN", "+Inf", "-Inf") else 0)
    print(table(rows[:args.top], tuple(keys + ["value"])))
    if len(rows) > args.top:
        print(f"  ... {len(rows) - args.top} more (raise --top)")
    return 0


def cmd_range(args) -> int:
    start, end, step = window(args)
    res = query_range(args.expr, start, end, step)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    for s in res:
        label = ",".join(f"{k}={v}" for k, v in sorted(s["metric"].items()) if k != "__name__") or "value"
        vals = [float(v) for _, v in s["values"]]
        if not vals:
            continue
        print(f"{label}")
        print(f"  min {min(vals):.4g}   avg {sum(vals) / len(vals):.4g}   max {max(vals):.4g}   "
              f"last {vals[-1]:.4g}   n={len(vals)}")
        if args.plot:
            print("  " + sparkline(vals))
    return 0


def sparkline(vals: list[float], width: int = 60) -> str:
    blocks = " ▁▂▃▄▅▆▇█"
    if len(vals) > width:
        bucket = len(vals) / width
        vals = [max(vals[int(i * bucket):int((i + 1) * bucket)] or [0]) for i in range(width)]
    lo, hi = min(vals), max(vals)
    if hi == lo:
        return blocks[1] * len(vals)
    return "".join(blocks[min(8, int((v - lo) / (hi - lo) * 8) + 1)] for v in vals)


def cmd_metrics(args) -> int:
    names = _call("label/__name__/values", {}, method="GET")
    pat = args.pattern
    hits = sorted(n for n in names if (pat in n if pat else n.startswith("rig:")))
    if args.json:
        print(json.dumps(hits, indent=2))
        return 0
    for n in hits:
        print(n)
    print(f"\n{len(hits)} series names" + (f" matching {pat!r}" if pat else " in the rig: namespace"))
    return 0


# --------------------------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(prog="rig", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--at", metavar="RFC3339", help="evaluate at a past instant, e.g. 2026-08-14T03:00:00Z")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("why", help="one-shot verdict: what is wrong right now")
    s.set_defaults(fn=cmd_why)

    s = sub.add_parser("who", help="rank process groups by resource use")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--top", type=int, default=12)
    s.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now, e.g. 24h")
    s.add_argument("--agg", choices=["avg", "max", "min"], default="max")
    s.set_defaults(fn=cmd_who)

    s = sub.add_parser("timeline", help="load over time with the group that owned it")
    s.add_argument("--since", metavar="DUR", default="6h")
    s.add_argument("--step", metavar="DUR")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--agg", choices=["avg", "max"], default="max")
    s.add_argument("--top", type=int, default=3, help="groups to rank per bucket")
    s.add_argument("--show", type=int, default=3, help="groups to print per bucket")
    s.add_argument("--min-load", type=float, default=0.0, help="hide quiet buckets below this load-per-core")
    s.set_defaults(fn=cmd_timeline)

    s = sub.add_parser("thermals", help="temperatures and cooling degradation vs baseline")
    s.set_defaults(fn=cmd_thermals)

    s = sub.add_parser("disk", help="io, filesystems and SMART wear")
    s.set_defaults(fn=cmd_disk)

    s = sub.add_parser("alerts", help="what is firing")
    s.set_defaults(fn=cmd_alerts)

    s = sub.add_parser("health", help="is this stack itself working")
    s.set_defaults(fn=cmd_health)

    s = sub.add_parser("q", help="instant PromQL query")
    s.add_argument("expr")
    s.add_argument("--top", type=int, default=25)
    s.set_defaults(fn=cmd_q)

    s = sub.add_parser("range", help="range PromQL query, summarised")
    s.add_argument("expr")
    s.add_argument("--since", metavar="DUR", default="6h")
    s.add_argument("--step", metavar="DUR")
    s.add_argument("--plot", action="store_true", help="draw a sparkline")
    s.set_defaults(fn=cmd_range)

    s = sub.add_parser("metrics", help="list series names, rig: namespace by default")
    s.add_argument("pattern", nargs="?")
    s.set_defaults(fn=cmd_metrics)

    args = p.parse_args()
    try:
        return args.fn(args)
    except PromError as e:
        print(f"rig: {e}", file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
