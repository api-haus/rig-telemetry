         "sysctl -w lasts until the next boot; /etc/sysctl.d/ is what makes it stick"),
        ("containers", f"{len(_net_containers(args.at, top=99))} with their own namespace",
         "counted by cAdvisor — their sockets are out of the host's reach"),
        ("attributed", pct(f["attributed"]),
         f"{human_bytes(f['unattributed_bytes'])}/s of link traffic has no owner"),
        ("group names", "process-exporter" if source and float(source[0]["value"][1])
         else "comm only", source[0]["metric"].get("path", "") if source else ""),
        ("line speed", human_bits(f["capacity_down"]) if f["capacity_down"] else "not set",
         "RIG_NET_DOWN_MBIT / RIG_NET_UP_MBIT in .env"),
        ("ping targets", ", ".join(sorted(f["rtt"])) or "none",
         "RIG_NET_PING_TARGETS in .env"),
    ]
    if args.json:
        print(json.dumps([dict(zip(("check", "state", "detail"), r)) for r in rows], indent=2))
        return 0
    print(table(rows, ("check", "state", "detail")))
    print()
    if not f["conntrack"]:
        print("  Every UDP byte is unattributed, and QUIC is UDP — a browser reading video")
        print("  can be the busiest thing on the link and appear idle here. Give it an owner:")
        print("    sudo sysctl -w net.netfilter.nf_conntrack_acct=1")
        print("    echo net.netfilter.nf_conntrack_acct=1 | sudo tee /etc/sysctl.d/99-rig-net.conf")
    print("  Sockets are sampled, so a connection that opens and closes between two passes")
    print("  is never seen. `attributed` is the size of that gap, measured against the")
    print("  interface's own counters. docs/network.md")
    return 0


