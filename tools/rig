    print()

    print(rule("by model"))
    print(table([(r["harness"], r["model"], money(r["cost"]), f"{r['requests']:,.0f}")
                 for r in by_model[:args.top]],
                ("harness", "model", "list value", "responses")))
    print()

    print(rule(f"top {len(by_project)} projects"))
    print(table([(r["project"], r["harness"], money(r["cost"]),
                  toks(sum(r[k] for k in hu.BILLED_ROLES))) for r in by_project],
                ("project", "harness", "list value", "tokens")))
    print()

    print(rule("who did the work"))
