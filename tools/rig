def cmd_q(args) -> int:
    res = query(args.expr, args.at)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    if not res:
        print("  (empty result)")
        return 0
    keys = sorted({k for s in res for k in s["metric"] if k != "__name__"})
    rows = [tuple([s["metric"].get(k, "") for k in keys] + [s["value"][1]]) for s in res]
    rows.sort(key=lambda r: -float(r[-1]) if r[-1] not in ("NaN", "+Inf", "-Inf") else 0)
    print(table(rows[:args.top], tuple(keys + ["value"])))
    if len(rows) > args.top:
        print(f"  ... {len(rows) - args.top} more (raise --top)")
    return 0


def cmd_range(args) -> int:
    start, end, step = window(args)
    res = query_range(args.expr, start, end, step)
    if args.json:
        print(json.dumps(res, indent=2))
        return 0
    for s in res:
        label = ",".join(f"{k}={v}" for k, v in sorted(s["metric"].items()) if k != "__name__") or "value"
        vals = [float(v) for _, v in s["values"]]
        if not vals:
            continue
        print(f"{label}")
        print(f"  min {min(vals):.4g}   avg {sum(vals) / len(vals):.4g}   max {max(vals):.4g}   "
              f"last {vals[-1]:.4g}   n={len(vals)}")
        if args.plot:
            print("  " + sparkline(vals))
    return 0


def sparkline(vals: list[float], width: int = 60) -> str:
    blocks = " ▁▂▃▄▅▆▇█"
    if len(vals) > width:
        bucket = len(vals) / width
        vals = [max(vals[int(i * bucket):int((i + 1) * bucket)] or [0]) for i in range(width)]
    lo, hi = min(vals), max(vals)
    if hi == lo:
        return blocks[1] * len(vals)
    return "".join(blocks[min(8, int((v - lo) / (hi - lo) * 8) + 1)] for v in vals)


def cmd_metrics(args) -> int:
    names = _call("label/__name__/values", {}, method="GET")
    pat = args.pattern
    hits = sorted(n for n in names if (pat in n if pat else n.startswith("rig:")))
    if args.json:
        print(json.dumps(hits, indent=2))
        return 0
    for n in hits:
        print(n)
    print(f"\n{len(hits)} series names" + (f" matching {pat!r}" if pat else " in the rig: namespace"))
    return 0


# --------------------------------------------------------------------------

def main() -> int:
    # Carried by the top-level parser and by every subparser, so both
    # `rig --json why` and `rig why --json` work. Only one position working is
    # a trap for anything driving this from a script.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--at", metavar="RFC3339", help="evaluate at a past instant, e.g. 2026-08-14T03:00:00Z")

    p = argparse.ArgumentParser(prog="rig", description=__doc__, parents=[common],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    s = sub.add_parser("why", help="one-shot verdict: what is wrong right now")
    s.set_defaults(fn=cmd_why)

    s = sub.add_parser("who", help="rank process groups by resource use")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--top", type=int, default=12)
    s.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now, e.g. 24h")
    s.add_argument("--agg", choices=["avg", "max", "min"], default="max")
    s.set_defaults(fn=cmd_who)

    s = sub.add_parser("timeline", help="load over time with the group that owned it")
    s.add_argument("--since", metavar="DUR", default="6h")
    s.add_argument("--step", metavar="DUR")
    s.add_argument("--by", choices=sorted(BY), default="cpu")
    s.add_argument("--agg", choices=["avg", "max"], default="max")
    s.add_argument("--top", type=int, default=3, help="groups to rank per bucket")
    s.add_argument("--show", type=int, default=3, help="groups to print per bucket")
    s.add_argument("--min-load", type=float, default=0.0, help="hide quiet buckets below this load-per-core")
    s.set_defaults(fn=cmd_timeline)

    s = sub.add_parser("where", help="where the stack is installed on this machine")
    s.add_argument("--quiet", "-q", action="store_true", help="print the path alone")
    s.set_defaults(fn=cmd_where)

    s = sub.add_parser("containers", help="docker resource use, per compose stack")
    s.add_argument("--each", action="store_true", help="one row per container instead of per stack")
    s.add_argument("--sort", choices=sorted(STACK_BY), default="mem")
    s.add_argument("--top", type=int, default=15)
    s.add_argument("--since", metavar="DUR", help="aggregate over a window instead of now")
    s.add_argument("--agg", choices=["avg", "max"], default="max")
    s.set_defaults(fn=cmd_containers)

    s = sub.add_parser("thermals", help="temperatures and cooling degradation vs baseline")
    s.set_defaults(fn=cmd_thermals)

    s = sub.add_parser("disk", help="io, filesystems and SMART wear")
    s.set_defaults(fn=cmd_disk)

    s = sub.add_parser("alerts", help="what is firing")
    s.set_defaults(fn=cmd_alerts)

    s = sub.add_parser("health", help="is this stack itself working")
    s.set_defaults(fn=cmd_health)

    s = sub.add_parser("ai", help="what the AI coding harnesses spent, at API list prices")
    s.add_argument("--since", metavar="DUR", help="limit to a window, e.g. 30d")
    s.add_argument("--top", type=int, default=12)
    s.set_defaults(fn=cmd_ai)
    ai = s.add_subparsers(dest="aicmd",
                          parser_class=lambda **kw: argparse.ArgumentParser(parents=[common], **kw))

    a = ai.add_parser("daily", help="spend per day")
    a.add_argument("--since", metavar="DUR", default="30d")
    a.add_argument("--by-harness", action="store_true", help="one column per harness")
    a.set_defaults(fn=cmd_ai_daily)

    a = ai.add_parser("projects", help="spend per project")
    a.add_argument("--since", metavar="DUR")
    a.add_argument("--top", type=int, default=25)
    a.set_defaults(fn=cmd_ai_projects)

    a = ai.add_parser("models", help="spend per model, with the rates used")
    a.add_argument("--since", metavar="DUR")
    a.set_defaults(fn=cmd_ai_models)

    a = ai.add_parser("limits", help="subscription windows, where a harness publishes them")
    a.set_defaults(fn=cmd_ai_limits)

    a = ai.add_parser("scan", help="read new session files into the ledger now")
    a.add_argument("--harness", help="only this one")
    a.add_argument("--fetch-prices", action="store_true", help="refetch models.dev first")
    a.set_defaults(fn=cmd_ai_scan)

    a = ai.add_parser("doctor", help="what is read, what is priced, and what is missing")
    a.add_argument("--verify", action="store_true",
                   help="recount every session file and check the ledger against it")
    a.set_defaults(fn=cmd_ai_doctor)

    a = ai.add_parser("backfill", help="import ledger history into Prometheus")
    a.add_argument("--since", metavar="DUR", default="30d", help="how far back")
    a.add_argument("--step", metavar="DUR", default="5m",
                   help="sample spacing; 5m is what Prometheus can read without gaps")
    a.add_argument("--out", metavar="PATH", help="where to write the OpenMetrics file")
    a.add_argument("--dry-run", action="store_true", help="write the file, print the commands")
    a.add_argument("--undo", action="store_true",
                   help="delete every aiusage_* sample in the window instead, to import again")
    a.set_defaults(fn=cmd_ai_backfill)

    s = sub.add_parser("q", help="instant PromQL query")
    s.add_argument("expr")
    s.add_argument("--top", type=int, default=25)
    s.set_defaults(fn=cmd_q)

    s = sub.add_parser("range", help="range PromQL query, summarised")
    s.add_argument("expr")
    s.add_argument("--since", metavar="DUR", default="6h")
    s.add_argument("--step", metavar="DUR")
    s.add_argument("--plot", action="store_true", help="draw a sparkline")
    s.set_defaults(fn=cmd_range)

    s = sub.add_parser("metrics", help="list series names, rig: namespace by default")
    s.add_argument("pattern", nargs="?")
    s.set_defaults(fn=cmd_metrics)

    pre, _ = common.parse_known_args()
    args = p.parse_args()
    args.json = args.json or pre.json
    args.at = args.at or pre.at
    try:
        return args.fn(args)
    except PromError as e:
        print(f"rig: {e}", file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
