SPEEDTEST = os.environ.get("RIG_NET_SPEEDTEST", "https://speed.cloudflare.com")
BLOAT_GRADES = ((1.5, "A", "the queue is short; interactive traffic survives a full link"),
                (2.5, "B", "noticeable under load"),
                (4.0, "C", "a call or a game degrades while anything downloads"),
                (8.0, "D", "everything lags whenever the line is busy"),
                (1e9, "F", "the router queues seconds of traffic; nothing interactive works"))


def _fill(url: str, seconds: float, upload: bool, streams: int = 4) -> tuple[float, float]:
    """Move as much as fits in `seconds`, and report bytes/s and the window.

    Several connections at once, because one TCP stream on a lossy or
    long-latency path reports the stream's ceiling and not the line's.
    """
    import threading

    chunk = 1 << 20
    block = os.urandom(chunk) * 8
    # The default python User-Agent is refused by the endpoint serving this.
    opener = urllib.request.build_opener()
    opener.addheaders = [("User-Agent", "rig-telemetry")]
    moved = [0] * streams
    started = time.monotonic()
    deadline = started + seconds

    def worker(slot: int):
        while time.monotonic() < deadline:
            try:
                if upload:
                    req = urllib.request.Request(
                        url, data=block, method="POST",
                        headers={"Content-Type": "application/octet-stream"})
                    with opener.open(req, timeout=seconds * 2) as r:
                        r.read()
                    moved[slot] += len(block)
                else:
                    with opener.open(url, timeout=seconds * 2) as r:
                        while time.monotonic() < deadline:
                            part = r.read(chunk)
                            if not part:
                                break
                            moved[slot] += len(part)
            except OSError:
                return

    threads = [threading.Thread(target=worker, args=(i,), daemon=True) for i in range(streams)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    spent = time.monotonic() - started
    return sum(moved) / max(spent, 1e-6), spent


def _rtt_during(spent: float) -> tuple[float | None, float | None]:
    """What the exporter's probe saw while the line was full."""
    window = f"{max(15, int(spent) + 5)}s"
    return (scalar(f'max(max_over_time(rig:net:rtt_seconds{{kind="internet"}}[{window}]))'),
            scalar(f'max(max_over_time(rig:net:loss_ratio[{window}]))'))


def cmd_net_speedtest(args) -> int:
    """Fill the line on purpose, and measure what that does to everything else.

    A throughput figure alone is the least useful half of this. The other half
    is the round trip time while those bytes are moving: that is the number
    that decides whether a call survives a download, and no speed test that
    reports megabits alone will ever show it.
    """
    idle = scalar('min(rig:net:rtt_floor_seconds{kind="internet"})')
    if idle is None:
        print("rig: no idle round trip time recorded yet — start the net exporter first.",
              file=sys.stderr)
        return 2
    size = 50_000_000                        # the endpoint refuses more in one request
    print(f"filling the line from {SPEEDTEST} for {args.seconds:g}s each way. "
          f"Everything on this machine will feel it.\n")

    down, down_spent = _fill(f"{SPEEDTEST}/__down?bytes={size}", args.seconds, upload=False)
    down_rtt, down_loss = _rtt_during(down_spent)
    up = up_spent = up_rtt = up_loss = None
    if not args.down_only:
        up, up_spent = _fill(f"{SPEEDTEST}/__up", args.seconds, upload=True)
        up_rtt, up_loss = _rtt_during(up_spent)

    grade = lambda r: next(g for limit, g, _ in BLOAT_GRADES if r < limit) if r else "?"
    why = lambda r: next(w for limit, _, w in BLOAT_GRADES if r < limit) if r else ""
    down_ratio = (down_rtt / idle) if down_rtt else None
    up_ratio = (up_rtt / idle) if up_rtt else None
    worst = max(r for r in (down_ratio, up_ratio) if r is not None)

    if args.json:
        print(json.dumps({
            "idle_rtt_seconds": idle,
            "download": {"bytes_per_sec": down, "bits_per_sec": down * 8,
                         "rtt_seconds": down_rtt, "rtt_ratio": down_ratio, "loss": down_loss},
            "upload": {"bytes_per_sec": up, "bits_per_sec": up and up * 8,
                       "rtt_seconds": up_rtt, "rtt_ratio": up_ratio, "loss": up_loss},
            "bufferbloat_grade": grade(worst),
        }, indent=2))
        return 0

    print(rule("throughput"))
    rows = [("download", human_bytes(down) + "/s", human_bits(down * 8),
             ms(down_rtt), num(down_ratio, "{:.1f}x"), pct(down_loss))]
    if up:
        rows.append(("upload", human_bytes(up) + "/s", human_bits(up * 8),
                     ms(up_rtt), num(up_ratio, "{:.1f}x"), pct(up_loss)))
    print(table(rows, ("direction", "rate", "", "rtt while full", "vs idle", "loss")))
    print(f"  idle round trip {ms(idle)}")
    print()
    print(rule(f"bufferbloat: {grade(worst)}"))
    print(f"  {why(worst)}.")
    print(f"  Round trip went from {ms(idle)} idle to {ms(max(r for r in (down_rtt, up_rtt) if r))}"
          f" with the line full — {worst:.1f}x.")
    print("  This is a router queue, not a bandwidth shortage. A download speed cap only")
    print("  helps while it holds the line below full; SQM (fq_codel or cake) on the")
    print("  router fixes it at any rate.")
    print()
    print(rule("what to put in .env"))
    print(f"  RIG_NET_DOWN_MBIT={down * 8 / 1e6:.0f}")
    if up:
        print(f"  RIG_NET_UP_MBIT={up * 8 / 1e6:.0f}")
    print("  then: docker compose up -d net-exporter")
    print("  Measured over one short run on a link that had other traffic on it, so round")
    print("  these up to what the line is sold as if you know the figure.")
    return 0


def _sysctl_persisted(key: str = "nf_conntrack_acct") -> bool:
    """Whether a sysctl is written down anywhere, not merely set right now."""
    files = [pathlib.Path("/etc/sysctl.conf")]
    for folder in ("/etc/sysctl.d", "/run/sysctl.d", "/usr/lib/sysctl.d"):
        files += sorted(pathlib.Path(folder).glob("*.conf")) if pathlib.Path(folder).is_dir() else []
    for path in files:
        try:
            for line in path.read_text().splitlines():
                line = line.split("#")[0].strip()
                if key in line and line.endswith("1"):
                    return True
        except OSError:
            continue
    return False


