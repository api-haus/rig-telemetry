def _ai_backfill_undo(args) -> int:
    """Delete every imported sample in the window, so an import can be redone.

    It removes the live exporter's own samples in the same window too — there
    is no label that separates them, which is the point: they are the same
    series. The current totals are unaffected, because a counter carries its
    whole history in its value; only the drawn curve inside the window goes.
    """
    start = (datetime.now(timezone.utc) - parse_duration(args.since)).timestamp()
    match = '{__name__=~"aiusage_.+"}'
    params = urllib.parse.urlencode(
        [("match[]", match), ("start", f"{start:.0f}"), ("end", f"{datetime.now(timezone.utc).timestamp():.0f}")])
    for path in (f"delete_series?{params}", "clean_tombstones"):
        req = urllib.request.Request(f"{PROM}/api/v1/admin/tsdb/{path}", data=b"", method="POST")
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                r.read()
        except urllib.error.HTTPError as e:
            print(f"rig: {e.code} from admin API — Prometheus needs "
                  f"--web.enable-admin-api\n  {e.read()[:200].decode(errors='replace')}",
                  file=sys.stderr)
            return 2
    print(f"deleted {match} over the last {args.since}. "
          f"Re-import with: rig ai backfill --since {args.since}")
    return 0


def _when(stamp: float) -> str:
    return datetime.fromtimestamp(stamp).strftime("%Y-%m-%d %H:%M")


def _head_floor() -> tuple[float, str]:
    """The oldest sample Prometheus still holds in memory, and nothing later.

    Blocks are the persisted past; the head is the present, and it lives in
    memory until Prometheus cuts a block from it. A backfilled block that
    reaches into the head's range asserts that window is already on disk, so
    the next restart truncates the head down to the newest block and throws
    away live telemetry that had not been written yet.

    That is not a hypothetical: an earlier version of this command wrote
    samples right up to the moment it ran, and cost this stack two and a half
    hours of every exporter's data.
    """
    try:
        oldest = scalar("prometheus_tsdb_head_min_time_seconds")
    except PromError:
        oldest = None
    if oldest:
        return oldest, "the oldest sample Prometheus still holds in memory"
    midnight = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    return midnight.timestamp(), "the start of today — Prometheus did not answer"


def _sample(value: float) -> str:
    """A cost written exactly as the exporter writes it.

    Rounded to six places instead, a backfilled sample lands a fraction of a
    cent *above* the live one that follows it. Prometheus reads any decrease as
    a counter reset and `increase()` then adds the whole counter back, which is
    how a seven-day figure came out larger than the lifetime total.
    """
    return str(int(value)) if float(value).is_integer() else repr(float(value))


def cmd_ai_backfill(args) -> int:
    """Import the ledger's history into Prometheus as dated blocks.

    A counter only exists from the moment Prometheus starts watching it, so a
    fresh stack draws a flat line over months of real spend that the ledger
    already holds.

    The ledger's granularity is a day, but one sample a day is not a series
    Prometheus can read: a sample is only visible for five minutes after it is
    written, so a query between two daily points finds nothing and a `sum()`
    across sparse series silently drops every one that is not stamped at that
    instant. So each day's running total is repeated at `--step` through the
    day, which is what the exporter would have produced had it been running.
    Below `--step` the pre-exporter range shows gaps; `rig ai daily` is the
    exact figure and needs no import at all.
    """
    if args.undo:
        return _ai_backfill_undo(args)
    hu, db = _ledger(args)
    since = _since_day(args)
    step = int(parse_duration(args.step).total_seconds())
    if not 60 <= step <= 3600:
        raise SystemExit("rig: --step must be between 1m and 1h")
    key_cols = ("day", "harness", "provider", "model", "kind")
    rows = sorted(hu.totals(db, key_cols, since=since), key=lambda r: r["day"])
    if not rows:
        print("nothing to backfill.")
        return 0

    # Same label shape as the exporter serves, cost included and the scrape's
    # own job/instance carried over, or these would be different series that
    # double-count wherever the backfilled range meets the live one. The pair
    # is read back from a live sample rather than assumed.
    scraped = query("aiusage_cost_usd_total")
    fixed = scraped[0]["metric"] if scraped else {}
    common = f'job="{fixed.get("job", "harness")}",instance="{fixed.get("instance", "rig")}"'
    by_day: dict[str, list] = {}
    for r in rows:
        by_day.setdefault(r["day"], []).append(r)

    ceiling, why = _head_floor()
    running: dict[tuple, dict[str, float]] = {}
    lines = []
    for day in sorted(by_day):
        for r in by_day[day]:
            key = tuple(r[c] for c in key_cols[1:])
            acc = running.setdefault(key, {"requests": 0.0, **dict.fromkeys(
                [f"{w}_{role}" for role in hu.BILLED_ROLES for w in ("tok", "usd")], 0.0)})
            acc["requests"] += r["requests"]
            for role in hu.BILLED_ROLES:
                acc[f"tok_{role}"] += r[role]
                acc[f"usd_{role}"] += r[f"cost_{role}"]
        midnight = int(datetime.strptime(day, "%Y-%m-%d").timestamp())
        for offset in range(0, 86400, step):
            stamp = midnight + offset
            if stamp >= ceiling:
                break
            for key, acc in running.items():
                tags = (f'{common},harness="{key[0]}",provider="{key[1]}",'
                        f'model="{key[2]}",kind="{key[3]}"')
                lines.append(f"aiusage_requests_total{{{tags}}} {acc['requests']:.0f} {stamp}")
                for role in hu.BILLED_ROLES:
                    both = f'{{{tags},role="{role}"}}'
                    lines.append(f"aiusage_tokens_total{both} {acc[f'tok_{role}']:.0f} {stamp}")
                    lines.append(f"aiusage_cost_usd_total{both} "
                                 f"{_sample(acc[f'usd_{role}'])} {stamp}")

    body = ("# TYPE aiusage_cost_usd_total counter\n"
            "# TYPE aiusage_requests_total counter\n"
            "# TYPE aiusage_tokens_total counter\n"
            + "\n".join(lines) + "\n# EOF\n")
    if not lines:
        print(f"nothing to write: the ledger's history is newer than {_when(ceiling)}, "
              f"which is {why}.")
        return 0
    out = pathlib.Path(args.out or "/tmp/rig-ai-backfill.openmetrics")
    out.write_text(body)
    days = len(by_day)
    print(f"wrote {len(lines):,} samples ({out.stat().st_size / 1e6:.1f} MB) "
          f"over {days} days at {args.step} steps to {out}")
    print(f"  stops at {_when(ceiling)} — {why}. Everything after that is the "
          f"exporter's own to record.")

    if args.dry_run:
        print("\nimport them with:")
        print(f"  docker cp {out} rig-prometheus:/tmp/backfill.om")
        print("  docker exec rig-prometheus promtool tsdb create-blocks-from openmetrics "
              "/tmp/backfill.om /prometheus")
        print("  docker compose restart prometheus")
        return 0

    root, _ = stack_root()
    steps = [
        ["docker", "cp", str(out), "rig-prometheus:/tmp/backfill.om"],
        ["docker", "exec", "rig-prometheus", "promtool", "tsdb",
         "create-blocks-from", "openmetrics", "/tmp/backfill.om", "/prometheus"],
        ["docker", "compose", "-f", str(root / "docker-compose.yml"), "restart", "prometheus"],
    ]
    for step in steps:
        print("  $ " + " ".join(step))
        done = subprocess.run(step, capture_output=True, text=True)
        if done.returncode:
            print(done.stdout[-2000:] + done.stderr[-2000:], file=sys.stderr)
            print("rig: backfill stopped. Re-run with --dry-run to do it by hand.", file=sys.stderr)
            return 2
    print(f"\n{days} days of history are now in Prometheus. "
          "Grafana draws them on the next refresh.")
    return 0


