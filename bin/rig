#!/usr/bin/env bash
# On PATH once the plugin is installed. Pure bash: no coreutils, so it survives
# a stripped PATH. Resolves symlinks, so it works from the repo, from the
# plugin cache, and from a link dropped in ~/.local/bin.
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *)  self="${self%/*}/$target" ;;
    esac
done
dir="${self%/*}"
[ "$dir" = "$self" ] && dir="."
exec "$dir/../tools/rig" "$@"
