          "legendFormat": "CPU path overall",
          "datasource": {
            "type": "prometheus",
            "uid": "rig-prom"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "D",
          "expr": "rig:thermal:mount_degradation_ratio",
          "legendFormat": "cold plate / paste",
          "datasource": {
            "type": "prometheus",
            "uid": "rig-prom"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0.8,
            "axisSoftMax": 1.5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0.8,
          "max": 1.5,
          "noValue": "No baseline yet \u2014 needs 37 days of history (7-day window vs. the same week 30 days earlier)."
