    {
      "type": "timeseries",
      "title": "Cooling efficiency vs. one month ago",
      "description": "1.0 = same cooling as a month ago. 1.15+ on the GPU or radiator line is dust: the same watts now need more degrees to move. The cold plate line separates dried paste from a dirty radiator. This panel always shows 90 days regardless of the dashboard range.",
      "datasource": {
        "type": "prometheus",
        "uid": "rig-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rig:thermal:gpu_degradation_ratio",
