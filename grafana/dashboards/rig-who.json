{
  "uid": "rig-who",
  "title": "Rig \u2014 Who",
  "description": "Every resource, attributed to a named process group. Groups are defined in process-exporter/config.yml.",
  "tags": [
    "rig",
    "attribution"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
